[34:20m2026-07-08 11:57:37,588 - iac-eval - INFO - Model raw output:   Here is a Terraform HCL program that provisions a secure PostgreSQL database instance within a specified AWS VPC, leveraging AWS services like RDS, subnets, and KMS for encryption:
```
provider "aws" {
  region = "us-east-1"
}

resource "aws_vpc" "example" {
  cidr_block = "10.0.0.0/16"
}

resource "aws_subnet" "example" {
  vpc_id     = aws_vpc.example.id
  cidr_block = "10.0.1.0/24"
}

resource "aws_kms_key" "example" {
  description = "Example KMS key for PostgreSQL encryption"
}

resource "aws_rds_cluster" "example" {
  cluster_identifier = "example-cluster"
  engine             = "aurora-postgresql"
  engine_version     = "13.4"
  availability_zones = ["us-east-1a", "us-east-1b"]
  database_name      = "exampledb"
  master_username    = "exampleuser"
  master_password    = "examplepassword"
  storage_encrypted  = true
  kms_key_id         = aws_kms_key.example.arn
  vpc_security_group_ids = [aws_security_group.example.id]
  db_subnet_group_name   = aws_db_subnet_group.example.name
  parameter_group_name   = aws_db_parameter_group.example.name
  multi_az               = true
  storage_size           = 20
}

resource "aws_db_subnet_group" "example" {
  name       = "example-subnet-group"
  subnet_ids = [aws_subnet.example.id]
}

resource "aws_db_parameter_group" "example" {
  name        = "example-parameter-group"
  family      = "aurora-postgresql13"

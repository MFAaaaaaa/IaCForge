Here is the Terraform HCL program:
```
provider "aws" {
  region = "us-west-2"
}

resource "aws_lex_bot" "pizza_bot" {
  name = "PizzaBot"
  description = "A bot for ordering pizza"

  intent {
    name = "OrderPizza"
    description = "Order a pizza"

    follow_up_question {
      question = "Would you like to add any toppings to your pizza?"
      answer = "Yes"
    }
  }
}

resource "aws_lambda_function" "pizza_bot_lambda" {
  function_name = "PizzaBotLambda"
  runtime = "nodejs14.x"
  handler = "index.handler"
  role = aws_iam_role.pizza_bot_lambda_role.arn
  source_code_hash = filebase64sha256("lambda_function.zip")
}

resource "aws_iam_role" "pizza_bot_lambda_role" {
  name = "PizzaBotLambdaRole"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Principal = {
          Service = "lambda.amazonaws.com"
        }
        Action = "sts:AssumeRole"
      }
    ]
  })
}
```

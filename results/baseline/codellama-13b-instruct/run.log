Here is the Terraform HCL program:
```
provider "aws" {
  region = "us-east-1"
}

resource "aws_lightsail_instance" "wordpress" {
  name              = "wordpress"
  availability_zone = "us-east-1a"
  blueprint_id      = "wordpress"
  bundle_id         = "wordpress"
  key_pair_name     = "my-key-pair"
  public_ip_address = true
}

resource "aws_lightsail_database" "wordpress" {
  name              = "wordpress"
  instance_name     = aws_lightsail_instance.wordpress.name
  username          = "wordpress"
  password          = "my-password"
  database_name     = "wordpress"
  database_engine   = "mysql"
  database_version  = "5.7"
  database_storage  = 20
  database_backup   = true
}

resource "aws_lightsail_web_server" "wordpress" {
  name              = "wordpress"
  instance_name     = aws_lightsail_instance.wordpress.name
  username          = "wordpress"
  password          = "my-password"
  database_name     = aws_lightsail_database.wordpress.name
  database_engine   = "mysql"
  database_version  = "5.7"
  database_storage  = 20
  database_backup   = true
}

resource "aws_iam_role" "wordpress" {
  name = "wordpress"

  assume_role_policy = <<EOF
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "lightsail.amazonaws.com"
      },
      "Action": "sts:AssumeRole"
    }
  ]
}
EOF
}

resource "aws_iam_policy" "wordpress" {
  name = "wordpress"

  policy = <<EOF
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "lightsail:*",
        "iam:*",
        "ec2:*",
        "rds:*"
      ],
      "Resource": "*"
    }
  ]
}
EOF
}

resource "aws_iam_role_policy_attachment" "wordpress" {
  role       = aws_iam_role.wordpress.name
  policy_arn = aws_iam_policy.wordpress.arn
}
```

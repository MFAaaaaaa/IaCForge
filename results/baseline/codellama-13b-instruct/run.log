resource "aws_db_instance" "airbyte_connector_test_db" {
  allocated_storage    = 5
  storage_type         = "gp2"
  engine               = "postgres"
  engine_version       = "15.0"
  instance_class       = "db.t3.micro"
  name                 = "airbyte_connector_test_db"

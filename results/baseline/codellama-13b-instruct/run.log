  name        = "airbyte_connector_test_sg"
  description = "Security group for Airbyte connector test database"
  vpc_id      = aws_vpc.airbyte_connector_test_vpc.id

  ingress {
    from_port   = 5432
    to_port     = 5432
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }


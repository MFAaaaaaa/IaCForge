    sample_utterances = [
      "I want to order a pizza",
      "Can I get a pizza?",
      "I'd like to order a pizza",
    ]

    fulfillment_activity {
      type = "ReturnIntent"
      message {
        content = "Ordering pizza..."
      }
    }
  }
}

resource "aws_lambda_function" "pizza_order_lambda" {
  function_name = "pizza_order_lambda"
  runtime = "nodejs14.x"
  handler = "index.handler"
  role = aws_iam_role.pizza_order_lambda_role.arn
  source_code_hash = filebase64sha256("pizza_order_lambda.zip")
}

resource "aws_iam_role" "pizza_order_lambda_role" {
  name = "pizza_order_lambda_role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Principal = {
          Service = "lambda.amazonaws.com"
        }
        Action = "sts:AssumeRole"
      },
    ]
  })
}
```

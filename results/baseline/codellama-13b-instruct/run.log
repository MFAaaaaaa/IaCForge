```
provider "aws" {
  region = "us-east-1"
}

resource "aws_vpc" "example" {
  cidr_block = "10.0.0.0/16"
}

resource "aws_subnet" "example" {
  vpc_id     = aws_vpc.example.id
  cidr_block = "10.0.1.0/24"
}

resource "aws_security_group" "example" {
  vpc_id = aws_vpc.example.id

  ingress {
    from_port   = 3306
    to_port     = 3306
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_iam_role" "example" {
  name = "example-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = "sts:AssumeRole"
        Effect = "Allow"
        Principal = {
          Service = "rds.amazonaws.com"
        }
      },
    ]
  })
}

resource "aws_secretsmanager_secret" "example" {
  name = "example-secret"
}

resource "aws_secretsmanager_secret_version" "example" {
  secret_id     = aws_secretsmanager_secret.example.id
  secret_string = "example-secret-string"
}

resource "aws_rds_cluster" "example" {
  cluster_identifier = "example-cluster"
  engine             = "aurora-mysql"
  engine_version     = "5.7.mysql_aurora.2.07.2"
  availability_zones = ["us-east-1a", "us-east-1b"]
  database_name      = "example-db"
  master_username    = "example-user"
  master_password    = "example-password"
  vpc_security_group_ids = [aws_security_group.example.id]
  db_subnet_group_name   = aws_db_subnet_group.example.name
  iam_roles              = [aws_iam_role.example.arn]
  secrets_manager_arn    = aws_secretsmanager_secret.example.arn
  idle_client_timeout    = 1800
  debug_logging          = false
}
```
This Terraform program creates the following resources:

* A VPC with a CIDR block of 10.0.0.0/16
* A subnet within the VPC with a CIDR block of 10.0.1.0/24
* A security group that allows inbound traffic on port 3306 from anywhere
* An IAM role that allows the RDS cluster to assume the role
* A Secrets Manager secret that stores the database credentials
* An RDS Aurora MySQL cluster with the specified configuration


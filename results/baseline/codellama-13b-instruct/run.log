[34:20m2026-07-08 11:13:58,904 - iac-eval - INFO - Model raw output:   Here is the Terraform HCL program that creates an IAM policy document that allows the 's3.amazonaws.com' service to publish to an SNS topic for S3 event notifications:
```
provider "aws" {
  region = "us-east-1"
}

resource "aws_iam_policy" "s3_event_notification_policy" {
  name        = "s3-event-notification-policy"
  description = "Policy for S3 event notifications"

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid       = "AllowSNSPublish"
        Effect    = "Allow"
        Action    = "SNS:Publish"
        Resource  = "arn:aws:sns:us-east-1:123456789012:s3-event-notification-topic"
        Condition = {
          StringEquals = {
            "aws:SourceArn" = "arn:aws:s3:::your-bucket-name"
          }
        }
      }
    ]
  })
}

resource "aws_sns_topic" "s3_event_notification_topic" {
  name = "s3-event-notification-topic"
}

resource "aws_s3_bucket" "your-bucket-name" {
  bucket = "your-bucket-name"

  notification_configuration {
    topic_arn = aws_sns_topic.s3_event_notification_topic.arn
    events    = ["s3:ObjectCreated:*"]
    filter_suffix = ".log"
  }

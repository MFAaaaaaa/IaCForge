  engine = "mysql"
  engine_version = "5.7"
  instance_class = "db.t2.micro"
  allocated_storage = 20
  storage_type = "gp2"
  storage_encrypted = false
  username = "my-username"
  password = "my-password"
  db_name = "my-database"
  multi_az = true
  publicly_accessible = false
  vpc_security_group_ids = [aws_security_group.sql.id]
  db_subnet_group_name = aws_db_subnet_group.sql.name
  parameter_group_name = "default.mysql5.7"
  option_group_name = "default:mysql-5-7"
  availability_zone = "us-east-1a"
  backup_retention_period = 7
  backup_window = "07:00-09:00"
  maintenance_window = "mon:00:00-mon:03:00"
  monitoring_interval = 60
  monitoring_role_arn = "arn:aws:iam::123456789012:role/my-monitoring-role"
  monitoring_role_name = "my-monitoring-role"
  monitoring_role_description = "My monitoring role"
  monitoring_role_policy_name = "my-monitoring-role-policy"
  monitoring_role_policy_description = "My monitoring role policy"
  monitoring_role_policy_document = <<EOF
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "rds:DescribeDBInstances",
      "Resource": "*"
    }
  ]
}
EOF
}

resource "aws_security_group" "sql" {
  name = "my-sql-security-group"
  description = "My SQL security group"
  vpc_id = "vpc-12345678"

  ingress {
    from_port = 3306
    to_port = 3306
    protocol = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port = 0
    to_port = 0
    protocol = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_db_subnet_group" "sql" {
  name = "my-sql-subnet-group"
  description = "My SQL subnet group"
  subnet_ids = ["subnet-12345678", "subnet-87654321"]
}
```

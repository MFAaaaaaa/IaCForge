provider "aws" {
  region = "us-east-1"
}

resource "aws_s3_bucket" "wellcomecollection-platform-infra" {
  bucket = "wellcomecollection-platform-infra"
  acl    = "private"

  lifecycle_rule {
    id      = "tmp-objects"
    prefix  = "tmp/"
    enabled = true

    expiration {
      days = 30
    }
  }

  versioning {
    enabled = true
  }

  lifecycle_rule {
    id      = "standard-ia-transition"
    prefix  = "tmp/"
    enabled = true

    transition {
      days          = 30
      storage_class = "STANDARD_IA"
    }
  }

  lifecycle_rule {
    id      = "noncurrent-version-deletion"
    prefix  = "tmp/"
    enabled = true

    noncurrent_version_expiration {
      days = 90
    }
  }
}
```

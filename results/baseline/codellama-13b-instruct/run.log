  zone_id = "Z1234567890ABCDEF"
  name    = "example.com"
  type    = "A"

  alias {
    name                   = "example-secondary.com"
    zone_id                = "Z1234567890ABCDEF"
    evaluate_target_health = true
  }
}

resource "aws_route53_record" "failover" {
  zone_id = "Z1234567890ABCDEF"
  name    = "example.com"
  type    = "A"


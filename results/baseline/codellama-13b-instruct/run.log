provider "aws" {
  region = "us-west-2"
}

resource "aws_lex_bot" "pizza_bot" {
  name = "PizzaBot"
  description = "A bot for ordering pizzas"
  nlu_intent_confidence_threshold = 0.5

  resource "aws_lex_intent" "order_pizza" {
    name = "OrderPizza"
    description = "Order a pizza"
    sample_utterances = [
      "I want to order a pizza",
      "Can I get a pizza?",
      "I'd like to order a pizza",
    ]
  }

  resource "aws_lex_intent" "cancel_order" {
    name = "CancelOrder"
    description = "Cancel an order"
    sample_utterances = [
      "I want to cancel my order",
      "I don't want to order a pizza",
      "I'd like to cancel my order",
    ]
  }

  resource "aws_lex_intent" "get_order_status" {
    name = "GetOrderStatus"
    description = "Get the status of an order"
    sample_utterances = [
      "What is the status of my order?",
      "Can you tell me the status of my order?",
      "I'd like to know the status of my order",
    ]
  }

  resource "aws_lex_intent" "get_menu" {
    name = "GetMenu"
    description = "Get the menu"
    sample_utterances = [
      "What is the menu?",
      "Can you tell me the menu?",
      "I'd like to see the menu",
    ]
  }

  resource "aws_lex_intent" "get_delivery_time" {
    name = "GetDeliveryTime"
    description = "Get the delivery time"
    sample_utterances = [
      "When will my pizza be delivered?",
      "Can you tell me the delivery time?",
      "I'd like to know the delivery time",
    ]
  }

  resource "aws_lex_intent" "get_payment_method" {
    name = "GetPaymentMethod"
    description = "Get the payment method"
    sample_utterances = [
      "What is the payment method?",
      "Can you tell me the payment method?",
      "I'd like to know the payment method",
    ]
  }

  resource "aws_lex_intent" "get_contact_information" {
    name = "GetContactInformation"
    description = "Get the contact information"
    sample_utterances = [
      "What is the contact information?",
      "Can you tell me the contact information?",
      "I'd like to know the contact information",
    ]
  }

  resource "aws_lex_intent" "get_help" {
    name = "GetHelp"
    description = "Get help"
    sample_utterances = [
      "I need help",
      "Can you help me?",
      "I'd like to get help",
    ]
  }

  resource "aws_lex_intent" "get_faq" {
    name = "GetFAQ"
    description = "Get the FAQ"
    sample_utterances = [
      "What is the FAQ?",
      "Can you tell me the FAQ?",
      "I'd like to know the FAQ",
    ]
  }

  resource "aws_lex_intent" "get_about" {
    name = "GetAbout"
    description = "Get the about page"
    sample_utterances = [
      "What is the about page?",
      "Can you tell me the about page?",
      "I'd like to know the about page",
    ]
  }

  resource "aws_lex_intent" "get_privacy_policy" {
    name = "GetPrivacyPolicy"
    description = "Get the privacy policy"
    sample_utterances = [
      "What is the privacy policy?",
      "Can you tell me the privacy policy?",
      "I'd like to know the privacy policy",
    ]
  }

  resource "aws_lex_intent" "get_terms_of_service" {
    name = "GetTermsOfService"
    description = "Get the terms of service"
    sample_utterances = [
      "What are the terms of service?",
      "Can you tell me the terms of service?",
      "I'd like to know the terms of service",
    ]
  }
}
```

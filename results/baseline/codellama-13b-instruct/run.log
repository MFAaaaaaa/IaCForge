  engine_version    = "13.4"
  storage_size      = 20
  storage_type      = "gp2"
  backup_retention  = 7
  backup_window     = "00:00-01:00"
  maintenance_window = "sun:00:00-sun:01:00"
}

resource "aws_lightsail_database_snapshot" "example" {
  name              = "example-snapshot"
  database_name     = aws_lightsail_database.example.name
  instance_name     = aws_lightsail_instance.example.name
  username          = "example-username"
  password          = "example-password"
  engine            = "postgres"
  engine_version    = "13.4"
  storage_size      = 20
  storage_type      = "gp2"
  backup_retention  = 7
  backup_window     = "00:00-01:00"
  maintenance_window = "sun:00:00-sun:01:00"
}
```

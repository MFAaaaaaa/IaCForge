This Terraform program will create an autograder infrastructure for a CS class using AWS services. It will create an S3 bucket to store students' code, a CodeBuild project to run the code, and a VPC to isolate the autograder from the internet. The program will also create an IAM role to allow CodeBuild to access the S3 bucket and run the code.

Here is the Terraform HCL program:
```
provider "aws" {
  region = "us-east-1"
}

resource "aws_s3_bucket" "code_bucket" {
  bucket = "cs-autograder-code"
  acl    = "private"
}

resource "aws_codebuild_project" "autograder" {
  name          = "cs-autograder"
  description   = "Autograder for CS class"
  service_role  = aws_iam_role.codebuild_role.arn
  artifacts {
    type = "CODEPIPELINE"
  }
  environment {
    compute_type = "BUILD_GENERAL1_SMALL"
    image        = "aws/codebuild/standard:4.0"
    type         = "LINUX_CONTAINER"
  }
  source {
    type      = "GITHUB"
    location  = "https://github.com/<username>/<repository>"
    git_clone_depth = 1
    git_submodules_config {
      fetch_submodules = true
    }
  }
}

resource "aws_iam_role" "codebuild_role" {
  name = "cs-autograder-codebuild-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = "sts:AssumeRole"
        Effect = "Allow"
        Principal = {
          Service = "codebuild.amazonaws.com"
        }
      },
    ]
  })
}

resource "aws_iam_role_policy" "codebuild_policy" {
  name = "cs-autograder-codebuild-policy"
  role = aws_iam_role.codebuild_role.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = [
          "s3:GetObject",
          "s3:PutObject",
          "s3:DeleteObject",
        ]
        Effect   = "Allow"
        Resource = "arn:aws:s3:::${aws_s3_bucket.code_bucket.id}/*"
      },
    ]
  })
}

resource "aws_vpc" "autograder_vpc" {
  cidr_block = "10.0.0.0/16"
  enable_dns_hostnames = true
  enable_dns_support = true
  tags = {
    Name = "cs-autograder-vpc"
  }
}

resource "aws_subnet" "autograder_subnet" {
  vpc_id     = aws_vpc.autograder_vpc.id
  cidr_block = "10.0.1.0/24"
  availability_zone = "us-east-1a"
  tags = {
    Name = "cs-autograder-subnet"
  }
}

resource "aws_security_group" "autograder_sg" {
  name        = "cs-autograder-sg"
  description = "Security group for autograder"
  vpc_id      = aws_vpc.autograder_vpc.id
  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
  tags = {
    Name = "cs-autograder-sg"
  }
}

resource "aws_instance" "autograder" {
  ami           = "ami-0c55b159cbfafe1f0"
  instance_type = "t2.micro"
  subnet_id     = aws_subnet.autograder_subnet.id
  vpc_security_group_ids = [aws_security_group.autograder_sg.id]
  key_name = "cs-autograder-key"
  tags = {
    Name = "cs-autograder"
  }
}
```
This program creates the following resources:

* An S3 bucket to store students' code
* A CodeBuild project to run the code
* A VPC to isolate the autograder from the internet
* An IAM role to allow CodeBuild to access the S3 bucket and run the code
* An IAM policy to allow CodeBuild to access the S3 bucket and run the code
* A subnet in the VPC to deploy the autograder instance
* A security group to allow inbound traffic on ports 22 and 80
* An EC2 instance to run the autograder

Note that this program assumes that the GitHub repository containing the students' code is publicly accessible. If the repository is private, you will need to modify the `source` block in the `aws_codebuild_project` resource to use the `GITHUB_TOKEN` environment variable to authenticate with GitHub. (eval.py:732)[0m

```
provider "aws" {
  region = "us-east-1"
}

resource "aws_route53_record" "example" {
  zone_id = "Z23ABC4XYZL05B"
  name    = "example.com"
  type    = "A"
  ttl     = 300
  records = ["192.0.2.1"]
}
```
This configuration creates a Route 53 record with the name `example.com` and the type `A`. The `records` attribute specifies the IP address that the record should route traffic to.

You can also use the `aws_route53_record` resource to create a record that routes traffic to a specific resource in your VPC. For example:
```
resource "aws_route53_record" "example" {
  zone_id = "Z23ABC4XYZL05B"
  name    = "example.com"
  type    = "A"
  ttl     = 300
  records = ["${aws_instance.example.private_ip}"]
}

resource "aws_instance" "example" {
  ami           = "ami-12345678"
  instance_type = "t2.micro"
  vpc_security_group_ids = ["sg-12345678"]
  subnet_id = "subnet-12345678"
}
```
This configuration creates a Route 53 record with the name `example.com` and the type `A`. The `records` attribute specifies the private IP address of the `aws_instance.example` resource.

You can also use the `aws_route53_record` resource to create a record that routes traffic to a specific load balancer. For example:
```
resource "aws_route53_record" "example" {
  zone_id = "Z23ABC4XYZL05B"
  name    = "example.com"
  type    = "A"
  ttl     = 300
  records = ["${aws_elb.example.dns_name}"]
}

resource "aws_elb" "example" {
  name            = "example-elb"
  availability_zones = ["us-east-1a", "us-east-1b"]
  listener {
    instance_port     = 80
    instance_protocol = "http"
    lb_port           = 80
    lb_protocol       = "http"
  }
}

  application = aws_elastic_beanstalk_application.my_api_app.name
  solution_stack_name = "64bit Amazon Linux 2 v3.4.1 running Python 3.9"

  autoscaling_configuration {
    min_size = 1
    max_size = 10
    desired_capacity = 5

    resource_lifecycle_config {

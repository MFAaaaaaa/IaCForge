provider "aws" {
  region = "us-east-1"
}

resource "aws_iam_role" "lightsail_role" {
  name = "lightsail-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Principal = {
          Service = "lightsail.amazonaws.com"
        }
        Action = "sts:AssumeRole"
      }
    ]
  })
}

resource "aws_iam_role_policy" "lightsail_policy" {
  name = "lightsail-policy"
  role = aws_iam_role.lightsail_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Action = "s3:*"
        Resource = "arn:aws:s3:::my-bucket/*"
      }
    ]
  })
}

resource "aws_lightsail_instance" "example" {
  name = "example"
  availability_zone = "us-east-1a"
  blueprint_id = "lightsail-blueprint-1.0"
  bundle_id = "lightsail-bundle-1.0"
  key_pair_name = "my-key-pair"
  user_data = <<-EOF
    #!/bin/bash
    echo "Hello, World!" > index.html
    EOF

  iam_instance_profile = aws_iam_instance_profile.lightsail_profile.name
}

resource "aws_iam_instance_profile" "lightsail_profile" {
  name = "lightsail-profile"
  role = aws_iam_role.lightsail_role.name
}
```

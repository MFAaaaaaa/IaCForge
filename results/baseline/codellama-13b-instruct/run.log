```
provider "aws" {
  region = "us-east-1"
}

resource "aws_elastic_beanstalk_environment" "example" {
  name                = "example-env"
  application         = "example-app"
  solution_stack_name = "64bit Amazon Linux 2018.03 v2.12.16 running Go 1.12"

  autoscaling {
    min_size = 1
    max_size = 10

    cpu_utilization {
      target = 70
    }
  }
}

resource "aws_rds_instance" "example" {
  name                = "my_db1"
  engine              = "mysql"
  engine_version      = "5.7"
  instance_class      = "db.t2.micro"
  allocated_storage   = 20
  storage_type        = "gp2"
  db_name             = "my_db1"
  username            = "my_db1_user"
  password            = "my_db1_password"
  skip_final_snapshot = true
}

resource "aws_iam_instance_profile" "eb_ec2_profile" {
  name = "eb_ec2_profile"
  role = aws_iam_role.eb_ec2_role.name
}

resource "aws_iam_role" "eb_ec2_role" {
  name = "eb_ec2_role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = "sts:AssumeRole"
        Effect = "Allow"
        Principal = {
          Service = "ec2.amazonaws.com"
        }
      },
    ]
  })
}

resource "aws_iam_role_policy" "eb_ec2_policy" {
  name = "eb_ec2_policy"
  role = aws_iam_role.eb_ec2_role.name

  policy = jsonencode({

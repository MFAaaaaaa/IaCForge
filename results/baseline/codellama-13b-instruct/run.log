provider "aws" {
  region = "us-east-1"
}

resource "aws_eventbridge_event_rule" "daily_event_rule" {
  name        = "daily-event-rule"
  description = "Daily event rule to trigger the Lambda function"

  schedule_expression = "cron(0 7 * * ? *)"
}

resource "aws_eventbridge_event_target" "daily_event_target" {
  name = "daily-event-target"
  arn  = aws_lambda_function.daily_lambda.arn
}

resource "aws_lambda_function" "daily_lambda" {
  function_name = "daily-lambda"
  runtime       = "python3.8"
  handler       = "lambda_function.lambda_handler"
  role          = aws_iam_role.daily_lambda_role.arn
  memory_size   = 128
  timeout       = 30

  environment {
    variables = {
      TIMEZONE = "UTC"
    }
  }
}

resource "aws_iam_role" "daily_lambda_role" {
  name = "daily-lambda-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = "sts:AssumeRole"
        Effect = "Allow"
        Principal = {
          Service = "lambda.amazonaws.com"
        }
      },
    ]
  })
}

resource "aws_lambda_permission" "daily_lambda_permission" {
  statement_id  = "AllowExecutionFromEventBridge"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.daily_lambda.function_name
  principal     = "events.amazonaws.com"
  source_arn    = aws_eventbridge_event_rule.daily_event_rule.arn
}
```

provider "aws" {
  region = "us-east-1"
}

resource "aws_redshift_cluster" "example" {
  cluster_identifier = "example-redshift-cluster"
  node_type          = "dc2.large"
  number_of_nodes    = 2
  master_username    = "admin"
  master_password    = "password"
  vpc_security_group_ids = [aws_security_group.example.id]
  cluster_subnet_group_name = aws_redshift_subnet_group.example.name
  parameter_group_name = aws_redshift_parameter_group.example.name
}

resource "aws_redshift_parameter_group" "example" {
  name        = "example-redshift-parameter-group"
  family      = "redshift-1.0"
  description = "Example Redshift parameter group"

  parameter {
    name  = "query_group"
    value = "example-query-group"
  }
}

resource "aws_redshift_subnet_group" "example" {
  name        = "example-redshift-subnet-group"
  description = "Example Redshift subnet group"
  subnet_ids  = [aws_subnet.example.id]
}

resource "aws_security_group" "example" {
  name        = "example-redshift-security-group"
  description = "Example Redshift security group"
  vpc_id      = aws_vpc.example.id

  ingress {
    from_port   = 5439
    to_port     = 5439
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_vpc" "example" {
  cidr_block = "10.0.0.0/16"
}

resource "aws_subnet" "example" {
  cidr_block = "10.0.1.0/24"
  vpc_id     = aws_vpc.example.id
}

resource "aws_sns_topic" "example" {
  name = "example-redshift-sns-topic"
}

resource "aws_redshift_event_subscription" "example" {
  name            = "example-redshift-event-subscription"
  cluster_name    = aws_redshift_cluster.example.name
  event_categories = ["configuration-change"]
  sns_topic_arn   = aws_sns_topic.example.arn
}
```
This Terraform program creates the following resources:

* An AWS Redshift cluster named "example-redshift-cluster" with two nodes of type "dc2.large" and a parameter group named "example-redshift-parameter-group"
* An AWS Redshift parameter group named "example-redshift-parameter-group" with a single parameter named "query_group"
* An AWS Redshift subnet group named "example-redshift-subnet-group" with a single subnet named "example-subnet"
* An AWS security group named "example-redshift-security-group" with a single ingress rule allowing traffic on port 5439 from any IP address
* An AWS VPC named "example-vpc" with a single subnet named "example-subnet"
* An AWS SNS topic named "example-redshift-sns-topic"
* An AWS Redshift event subscription named "example-redshift-event-subscription" that sends events associated with the "example-redshift-parameter-group" parameter group to the "example-redshift-sns-topic" SNS topic


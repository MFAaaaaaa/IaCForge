[34:20m2026-07-07 20:08:58,356 - iac-eval - INFO - Model raw output: **Description of the Terraform Program:**

This Terraform configuration creates an AWS Lex bot named "PizzaOrderBot" designed for kids to order pizzas. The bot includes a basic conversation flow with intents such as "OrderPizza" and "ConfirmOrder", along with sample utterances and responses tailored for a child-friendly experience. The bot is configured with a Lambda function as a fulfillment activity to handle the actual order processing (though the Lambda function itself is not created in this configuration). The bot is deployed in the `us-east-1` region and includes an IAM role for the Lex bot to interact with other AWS services if needed.

---

```hcl
provider "aws" {
  region = "us-east-1"
}

resource "aws_lex_bot" "pizza_order_bot" {
  name                     = "PizzaOrderBot"
  description              = "A child-friendly bot for ordering pizzas."
  locale                   = "en-US"
  child_directed           = true
  abort_statement {
    messages {
      content      = "Okay, let's try again later."
      content_type = "PlainText"
    }
    response_card {
      version  = "1.0"
      title    = "Okay, let's try again later."
      generic_attachments {
        title    = "Okay, let's try again later."
        subtitle = "Okay, let's try again later."
        buttons {
          text = "Okay"
          value = "Okay"
        }
      }
    }
  }

  intents {
    intent_name = "OrderPizza"
    slots {
      name     = "PizzaType"
      slot_type = "AMAZON.Food"
      value_elicitation_prompt {
        messages {
          content      = "What type of pizza would you like?"
          content_type = "PlainText"
        }
        response_card {
          version  = "1.0"
          title    = "What type of pizza would you like?"
          generic_attachments {
            title    = "What type of pizza would you like?"
            subtitle = "What type of pizza would you like?"
            buttons {
              text = "Pepperoni"
              value = "Pepperoni"
            }
            buttons {
              text = "Cheese"
              value = "Cheese"
            }
            buttons {
              text = "Veggie"
              value = "Veggie"
            }
          }
        }
      }
    }
    sample_utterances = [
      "I want a pepperoni pizza",
      "Can I get a cheese pizza?",
      "I'd like a veggie pizza"
    ]
    fulfillment_activity {
      type = "Lambda"
      code_hook {
        uri = "arn:aws:lambda:us-east-1:123456789012:function:ProcessPizzaOrder"
        intent_name = "OrderPizza"
      }
    }
  }

  intents {
    intent_name = "ConfirmOrder"
    slots {
      name     = "Confirm"
      slot_type = "AMAZON.YesNo"
      value_elicitation_prompt {
        messages {
          content      = "Are you sure you want to order this pizza?"
          content_type = "PlainText"
        }
        response_card {
          version  = "1.0"
          title    = "Are you sure you want to order this pizza?"
          generic_attachments {
            title    = "Are you sure you want to order this pizza?"
            subtitle = "Are you sure you want to order this pizza?"
            buttons {
              text = "Yes"
              value = "Yes"
            }
            buttons {
              text = "No"
              value = "No"
            }
          }
        }
      }
    }
    sample_utterances = [
      "Yes, I want it",
      "No, I don't want it"
    ]
    fulfillment_activity {
      type = "Lambda"
      code_hook {
        uri = "arn:aws:lambda:us-east-1:123456789012:function:ProcessPizzaOrder"
        intent_name = "ConfirmOrder"
      }
    }
  }

  voice_id = "Joanna"
  idle_session_ttl_in_seconds = 300
}

resource "aws_iam_role" "lex_bot_role" {
  name = "LexBotRole"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "lex.amazonaws.com"
      }
      Action = "sts:AssumeRole"
    }]
  })
}


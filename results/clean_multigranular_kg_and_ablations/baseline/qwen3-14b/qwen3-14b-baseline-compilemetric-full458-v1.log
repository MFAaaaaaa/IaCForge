    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "example-alb-sg"
  }
}

resource "aws_lb_listener" "http-redirect" {
  load_balancer_arn = aws_lb.example.arn
  port              = 80
  protocol          = "HTTP"

  default_actions {
    type = "redirect"
    redirect {

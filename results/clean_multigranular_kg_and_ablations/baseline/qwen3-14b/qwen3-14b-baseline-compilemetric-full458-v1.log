This Terraform configuration sets up a basic AWS Neptune cluster with a custom parameter group. It also provisions a Neptune instance within that cluster, each with its own custom parameter group. The configuration includes the necessary provider setup, VPC, subnet group, and IAM roles to ensure the Neptune cluster and instance are deployed securely and efficiently in the AWS environment.

---

**Terraform HCL Program:**

```hcl
provider "aws" {
  region = "us-west-2"
}

# Create a VPC for Neptune
resource "aws_vpc" "neptune_vpc" {
  cidr_block = "10.0.0.0/16"
  tags = {
    Name = "neptune-vpc"
  }
}

# Create a subnet group for Neptune
resource "aws_db_subnet_group" "neptune_subnet_group" {
  name       = "neptune-subnet-group"
  subnet_ids = [aws_subnet.neptune_subnet1.id, aws_subnet.neptune_subnet2.id]
  tags = {
    Name = "neptune-subnet-group"
  }
}

# Create subnets for Neptune
resource "aws_subnet" "neptune_subnet1" {
  vpc_id            = aws_vpc.neptune_vpc.id
  cidr_block        = "10.0.1.0/24"
  availability_zone = "us-west-2a"
  tags = {
    Name = "neptune-subnet1"
  }
}

resource "aws_subnet" "neptune_subnet2" {
  vpc_id            = aws_vpc.neptune_vpc.id
  cidr_block        = "10.0.2.0/24"
  availability_zone = "us-west-2b"
  tags = {
    Name = "neptune-subnet2"
  }
}

# Create a custom parameter group for the Neptune cluster
resource "aws_neptune_parameter_group" "neptune_cluster_param_group" {
  name        = "neptune-cluster-param-group"
  family      = "neptune1.2"
  description = "Custom parameter group for Neptune cluster"
  parameters  = {
    "neptune_query_timeout" = "60"
  }
}

# Create a custom parameter group for the Neptune instance
resource "aws_neptune_parameter_group" "neptune_instance_param_group" {
  name        = "neptune-instance-param-group"
  family      = "neptune1.2"
  description = "Custom parameter group for Neptune instance"
  parameters  = {
    "neptune_max_connections" = "100"
  }
}

# Create a Neptune cluster
resource "aws_neptune_cluster" "neptune_cluster" {
  cluster_identifier              = "neptune-cluster"
  engine                          = "neptune"
  engine_version                  = "1.2.0.1"
  neptune_parameter_group_name    = aws_neptune_parameter_group.neptune_cluster_param_group.name
  backup_retention_period       = 5
  preferred_backup_window       = "07:00-09:00"
  skip_final_snapshot           = true
  db_subnet_group_name          = aws_db_subnet_group.neptune_subnet_group.name
  tags = {
    Name = "neptune-cluster"
  }
}

# Create a Neptune instance in the cluster
resource "aws_neptune_cluster_instance" "neptune_instance" {
  cluster_identifier              = aws_neptune_cluster.neptune_cluster.id
  instance_class                  = "db.r5.large"
  neptune_parameter_group_name    = aws_neptune_parameter_group.neptune_instance_param_group.name
  tags = {
    Name = "neptune-instance"
  }
}
```


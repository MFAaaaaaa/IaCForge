This Terraform configuration creates an AWS Lightsail Distribution with an S3 bucket as the origin. The configuration includes:

- An AWS S3 bucket to store static content.
- An IAM role and policy to allow Lightsail to access the S3 bucket.
- A Lightsail Distribution that points to the S3 bucket as the origin.
- A provider configuration for AWS in the `us-east-1` region.

This setup ensures that the Lightsail Distribution can serve content from the S3 bucket, making it suitable for hosting static websites or content delivery.

---

```hcl
provider "aws" {
  region = "us-east-1"
}

resource "aws_s3_bucket" "static_content" {
  bucket = "my-static-content-bucket-12345"
  acl    = "private"

  tags = {
    Name        = "static-content-bucket"
    Environment = "production"
  }
}

resource "aws_s3_bucket_policy" "static_content_policy" {
  bucket = aws_s3_bucket.static_content.bucket

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Principal = {
          Service = "lightsail.amazonaws.com"
        }
        Action = "s3:GetObject"
        Resource = "arn:aws:s3:::${aws_s3_bucket.static_content.bucket}/*"
      }
    ]
  })
}

resource "aws_iam_role" "lightsail_access_role" {
  name = "lightsail-access-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Principal = {
          Service = "lightsail.amazonaws.com"
        }
        Action = "sts:AssumeRole"
      }
    ]
  })
}

resource "aws_iam_role_policy_attachment" "s3_access" {
  role       = aws_iam_role.lightsail_access_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonS3ReadOnlyAccess"
}

resource "aws_lightsail_distribution" "static_site_distribution" {
  name              = "static-site-distribution"
  origin            = aws_s3_bucket.static_content.bucket
  originProtocolPolicy = "http-only"
  isEnabled         = true

  cacheBehavior {
    pathPattern = "/*"
    behavior    = "cache"
  }

  tags = {
    Name        = "static-site-distribution"
    Environment = "production"
  }
}

```hcl
provider "aws" {
  region = "us-west-2"
}

variable "cluster_identifier" {
  description = "The unique identifier for the Redshift cluster"
  default     = "my-redshift-cluster"
}

variable "node_type" {
  description = "The type of Redshift node"
  default     = "dc2.large"
}

variable "number_of_nodes" {
  description = "The number of nodes in the Redshift cluster"
  default     = 2
}

variable "cluster_type" {
  description = "The type of Redshift cluster"
  default     = "multi-node"
}

variable "master_username" {
  description = "The master username for the Redshift cluster"
  default     = "admin"
}

variable "master_password" {
  description = "The master password for the Redshift cluster"
  default     = "SecurePassword123!"
}

variable "database_name" {
  description = "The name of the Redshift database"
  default     = "mydb"
}

variable "cluster_subnet_group_name" {
  description = "The name of the Redshift subnet group"
  default     = "my-redshift-subnet-group"
}

variable "vpc_id" {
  description = "The ID of the VPC where the Redshift cluster will be deployed"
  default     = "vpc-12345678"
}

variable "subnet_ids" {
  description = "List of subnet IDs for the Redshift cluster"
  default     = ["subnet-12345678", "subnet-87654321"]
}

variable "security_group_id" {
  description = "The ID of the security group for the Redshift cluster"
  default     = "sg-12345678"
}

variable "concurrency_scaling_max_time" {
  description = "Maximum time (in minutes) for concurrency scaling"
  default     = 60
}

resource "aws_redshift_cluster" "example" {
  cluster_identifier          = var.cluster_identifier
  node_type                   = var.node_type
  number_of_nodes             = var.number_of_nodes
  cluster_type                = var.cluster_type
  master_username             = var.master_username
  master_password             = var.master_password
  database_name               = var.database_name
  cluster_subnet_group_name   = var.cluster_subnet_group_name
  vpc_id                      = var.vpc_id
  subnet_ids                  = var.subnet_ids
  security_group_ids          = [var.security_group_id]
  concurrency_scaling_enabled = true
  concurrency_scaling_max_time = var.concurrency_scaling_max_time
}

resource "aws_iam_role" "redshift_role" {
  name = "redshift-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = { Service = "redshift.amazonaws.com" }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "redshift_default" {
  role       = aws_iam_role.redshift_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonRedshiftReadOnlyAccess"
}

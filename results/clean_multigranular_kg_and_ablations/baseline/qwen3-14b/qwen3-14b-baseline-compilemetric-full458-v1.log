This Terraform configuration creates a Kinesis Data Stream and a Kinesis Data Firehose delivery stream that acts as a consumer of the Kinesis Data Stream. The Firehose delivery stream is configured to deliver data to an Amazon S3 bucket. The configuration includes the necessary IAM roles and policies to allow the Firehose delivery stream to write to the S3 bucket and to read from the Kinesis Data Stream.

---

**Terraform HCL Program:**

```hcl
provider "aws" {
  region = "us-west-2"
}

resource "aws_kinesis_stream" "example_stream" {
  name             = "example-kinesis-stream"
  shard_count      = 1
  retention_period = 24
}

resource "aws_s3_bucket" "example_bucket" {
  bucket = "example-kinesis-consumer-bucket"
  acl    = "private"
}

resource "aws_iam_role" "firehose_role" {
  name = "firehose-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "firehose.amazonaws.com"
      }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "firehose_s3" {
  role       = aws_iam_role.firehose_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonS3FullAccess"
}

resource "aws_iam_role_policy_attachment" "firehose_kinesis" {
  role       = aws_iam_role.firehose_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonKinesisFullAccess"
}

resource "aws_firehose_delivery_stream" "example_firehose" {
  name        = "example-firehose-delivery"
  destination = "s3"

  s3_configuration {
    role_arn       = aws_iam_role.firehose_role.arn
    bucket_arn     = aws_s3_bucket.example_bucket.arn
    buffer_interval = 300
    buffer_size     = 5
    compression_format = "UNCOMPRESSED"
  }

  kinesis_source_configuration {
    kinesis_stream_arn = aws_kinesis_stream.example_stream.arn
    role_arn           = aws_iam_role.firehose_role.arn
  }
}
```

---

This configuration will:
- Create a Kinesis Data Stream.
- Create an S3 bucket to store the data.
- Create an IAM role for the Firehose delivery stream with permissions to access both Kinesis and S3.
- Create a Firehose delivery stream that reads from the Kinesis stream and writes to the S3 bucket.

You can apply this configuration using `terraform apply` after initializing the Terraform working directory. (eval.py:730)[0m

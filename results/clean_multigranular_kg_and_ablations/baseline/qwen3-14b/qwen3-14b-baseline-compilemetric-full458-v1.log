This Terraform configuration creates a basic Amazon Kinesis Analytics Application using the AWS provider. The application is configured to process data from a Kinesis Data Stream and write the results to a Kinesis Data Firehose delivery stream. The configuration includes the necessary IAM roles and policies to allow the Kinesis Analytics application to read from the input stream and write to the output stream. All resources are created in the `us-east-1` region, and default values are provided for any variables used.

---

**Terraform HCL Program:**

```hcl
provider "aws" {
  region = "us-east-1"
}

resource "aws_iam_role" "kinesis_analytics_role" {
  name = "kinesis_analytics_role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = { Service = "kinesisanalytics.amazonaws.com" }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "kinesis_analytics_access" {
  role       = aws_iam_role.kinesis_analytics_role.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonKinesisAnalyticsRole"
}

resource "aws_kinesis_stream" "input_stream" {
  name             = "kinesis-input-stream"
  shard_count      = 1
  retention_period = 24
}

resource "aws_kinesis_firehose_delivery_stream" "output_stream" {
  name        = "kinesis-output-firehose"
  type        = "kinesis_stream"
  kinesis_stream {
    stream_arn = aws_kinesis_stream.input_stream.arn
  }

  tags = {
    Environment = "dev"
  }
}

resource "aws_kinesisanalyticsv2_application" "kinesis_analytics_app" {
  name        = "kinesis-analytics-app"
  runtime_environment = "SQL-1_0"
  service_execution_role = aws_iam_role.kinesis_analytics_role.arn

  application_configuration {
    sql_application_configuration {
      input {
        name            = "input"
        input_parallelism {
          count = 1
        }
        input_processing_configuration {
          input_lambda_processor {
            resource_arn = aws_lambda_function.example.arn
            role_arn     = aws_iam_role.lambda_role.arn
          }
        }
        kinesis_stream_source_configuration {
          stream_arn = aws_kinesis_stream.input_stream.arn
          role_arn   = aws_iam_role.kinesis_analytics_role.arn
        }
      }

      output {
        name            = "output"
        output_stream {
          name = aws_kinesis_firehose_delivery_stream.output_stream.name
        }
      }

      reference_data_source {
        reference_id = "reference"
        s3_reference_data_source {
          bucket_arn = aws_s3_bucket.reference.arn
          file_key   = "reference-data.csv"
          reference_data_source_format = "csv"
        }
      }
    }
  }

  tags = {
    Environment = "dev"
  }
}
```

---

**Note:** The above configuration assumes that you have already created a Lambda function and an S3 bucket for the reference data. If you need a complete standalone example, I can provide a version that includes those resources as well. Let me know if you'd like that. (eval.py:730)[0m

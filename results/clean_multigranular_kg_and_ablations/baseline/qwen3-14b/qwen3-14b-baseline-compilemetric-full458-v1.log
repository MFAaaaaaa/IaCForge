This Terraform configuration sets up a basic AWS Neptune cluster with a custom parameter group. The configuration includes:

- A Neptune cluster with a single instance.
- A custom parameter group that modifies the `neptune_query_timeout` parameter to 60 seconds.
- A provider configuration for AWS in the `us-west-2` region.
- Default values for variables such as cluster name, instance class, and database name.

---

**Terraform HCL Program:**

```hcl
provider "aws" {
  region = "us-west-2"
}

variable "neptune_cluster_name" {
  description = "Name of the Neptune cluster"
  default     = "my-neptune-cluster"
}

variable "neptune_instance_class" {
  description = "Instance class for Neptune cluster"
  default     = "db.r5.large"
}

variable "neptune_db_name" {
  description = "Name of the Neptune database"
  default     = "mygraph"
}

resource "aws_neptune_parameter_group" "custom" {
  name        = "custom-neptune-params"
  family      = "neptune1.2"
  description = "Custom Neptune parameter group"

  parameter {
    name  = "neptune_query_timeout"
    value = "60"
    apply_method = "immediate"
  }
}

resource "aws_neptune_cluster" "main" {
  cluster_identifier              = var.neptune_cluster_name
  engine                          = "neptune"
  engine_version                  = "1.2.0.1"
  neptune_parameter_group_name  = aws_neptune_parameter_group.custom.name
  backup_retention_period       = 5
  preferred_backup_window       = "07:00-09:00"
  skip_final_snapshot           = true
  db_subnet_group_name          = "default"
  iam_roles                     = []
  storage_encrypted             = false
  replication_source_identifier = null
  tags = {
    Environment = "dev"
  }
}

resource "aws_neptune_cluster_instance" "main" {
  cluster_identifier = aws_neptune_cluster.main.id
  instance_class     = var.neptune_instance_class
  db_name            = var.neptune_db_name
  promotion_tier     = 1
}
```


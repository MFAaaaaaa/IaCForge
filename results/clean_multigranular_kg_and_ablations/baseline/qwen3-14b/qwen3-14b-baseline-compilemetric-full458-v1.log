This Terraform configuration creates an AWS S3 bucket with a specified name, applies S3 bucket ownership controls to define the object ownership policy, and then sets up an S3 bucket ACL to enforce private access. The resources are connected through proper references, ensuring that the ACL is only applied after the ownership controls are successfully configured. The configuration includes a provider block for AWS, default values for variables, and ensures compatibility with Terraform 1.9.8 and the AWS provider version 5.75.

---

**Terraform HCL Configuration:**

```hcl
provider "aws" {
  region = "us-west-2"
}

variable "bucket_name" {
  description = "Name of the S3 bucket"
  default     = "my-unique-bucket-name"
}

resource "aws_s3_bucket" "example" {
  bucket = var.bucket_name
  acl    = "private" # Default ACL, will be overridden by ACL resource

  tags = {
    Name = "example-bucket"
  }
}

resource "aws_s3_bucket_ownership_controls" "example" {
  bucket = aws_s3_bucket.example.id

  rule {
    object_ownership = "BucketOwnerPreferred"
  }
}

resource "aws_s3_bucket_acl" "example" {
  bucket = aws_s3_bucket.example.id

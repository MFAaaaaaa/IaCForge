This Terraform configuration creates an AWS Chime Voice Connector with encryption enabled. It also sets up the streaming configuration for the voice connector, specifying a retention period of 5 hours, enabling notifications to be sent to an SNS topic, and disables streaming to Amazon Kinesis. The configuration includes the necessary IAM roles and policies to ensure proper permissions for the Chime Voice Connector and associated services.

---

**Terraform HCL Program:**

```hcl
provider "aws" {
  region = "us-east-1"
}

resource "aws_iam_role" "chime_voice_connector_role" {
  name = "chime-voice-connector-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "chime.amazonaws.com"
      }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "chime_voice_connector_policy" {
  role       = aws_iam_role.chime_voice_connector_role.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSChimeVoiceConnectorFullAccess"
}

resource "aws_sns_topic" "chime_voice_connector_notifications" {
  name = "chime-voice-connector-notifications"
}

resource "aws_chime_voice_connector" "example" {
  name                = "example-voice-connector"
  require_encryption  = true
  enable_logging      = true
  logging_config {
    enable_s3_backup = true
    s3_bucket_name   = "example-voice-connector-logs"
    s3_key_prefix    = "voice-connector-logs"
  }
  role_arn = aws_iam_role.chime_voice_connector_role.arn
}

resource "aws_chime_voice_connector_streaming" "example" {
  voice_connector_id = aws_chime_voice_connector.example.id
  retention_period   = 5
  data_retention_enabled = true
  streaming_notification_targets {
    sns_topic_arn = aws_sns_topic.chime_voice_connector_notifications.arn
  }
  kinesis_data_stream_enabled = false
}
```

---

**Notes:**

- Replace `"example-voice-connector-logs"` with a valid S3 bucket name that exists in your AWS account.
- Ensure that the S3 bucket has the appropriate permissions to allow Chime to write logs.
- The `aws_sns_topic` resource is created to receive notifications from the voice connector streaming.
- The `kinesis_data_stream_enabled` is set to `false` to disable streaming to Kinesis.
- The `retention_period` is set to 5 hours, which is the minimum allowed by AWS Chime. (eval.py:730)[0m

```hcl
provider "aws" {
  region = "us-east-1"
}

provider "aws" {
  region = "us-east-2"
  alias  = "us_east_2"
}

variable "cluster_name" {
  description = "Base name for the Redshift clusters"
  default     = "my-redshift-cluster"
}

variable "node_type" {
  description = "Type of Redshift node"
  default     = "dc2.large"
}

variable "cluster_size" {
  description = "Number of nodes in the cluster"
  default     = 2
}

variable "database_name" {
  description = "Name of the Redshift database"
  default     = "mydb"
}

variable "database_user" {
  description = "Username for the Redshift database"
  default     = "admin"
}

variable "database_password" {
  description = "Password for the Redshift database"
  default     = "SecureP@ssw0rd"
}

variable "cluster_subnet_group_name" {
  description = "Name of the Redshift subnet group"
  default     = "my-redshift-subnet-group"
}

variable "vpc_id" {
  description = "ID of the VPC to use for the Redshift clusters"
  default     = "vpc-12345678"
}

variable "subnet_ids" {
  description = "List of subnet IDs for the Redshift clusters"
  default     = ["subnet-12345678", "subnet-87654321"]
}

variable "security_group_id" {
  description = "ID of the security group to use for the Redshift clusters"
  default     = "sg-12345678"
}

resource "aws_redshift_cluster" "primary" {
  cluster_identifier      = "${var.cluster_name}-primary"
  node_type               = var.node_type
  cluster_type            = "multi-node"
  number_of_nodes         = var.cluster_size
  database_name           = var.database_name
  master_username         = var.database_user
  master_password         = var.database_password
  cluster_subnet_group_name = var.cluster_subnet_group_name
  vpc_id                  = var.vpc_id
  subnet_ids              = var.subnet_ids
  security_group_ids      = [var.security_group_id]
  skip_final_snapshot     = true
}

resource "aws_redshift_cluster" "replica" {
  provider                = aws.us_east_2
  cluster_identifier      = "${var.cluster_name}-replica"
  node_type               = var.node_type
  cluster_type            = "multi-node"
  number_of_nodes         = var.cluster_size
  database_name           = var.database_name
  master_username         = var.database_user
  master_password         = var.database_password
  cluster_subnet_group_name = var.cluster_subnet_group_name
  vpc_id                  = var.vpc_id
  subnet_ids              = var.subnet_ids
  security_group_ids      = [var.security_group_id]
  skip_final_snapshot     = true
  replication_group_identifier = aws_redshift_cluster.primary.replication_group_identifier
}
```


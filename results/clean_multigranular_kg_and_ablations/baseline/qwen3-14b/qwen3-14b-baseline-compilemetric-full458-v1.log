**Terraform HCL Program:**

```hcl
provider "aws" {
  region = "us-west-2"
}

variable "vpc_id" {
  description = "The ID of the VPC where the EFS and mount target will be created."
  default     = "vpc-12345678"
}

variable "subnet_id" {
  description = "The ID of the subnet where the mount target will be created."
  default     = "subnet-12345678"
}

variable "efs_file_system_name" {
  description = "The name of the EFS file system."
  default     = "my-efs-file-system"
}

resource "aws_efs_file_system" "example" {
  creation_token   = var.efs_file_system_name
  performance_mode = "generalPurpose"
  lifecycle_policy {
    transition_to_ia = "AFTER_7_DAYS"
  }
}

resource "aws_efs_mount_target" "example" {
  file_system_id = aws_efs_file_system.example.id
  subnet_id      = var.subnet_id
}
```

---


**Terraform HCL Program:**

```hcl
provider "aws" {
  region = "us-east-1"
}

resource "aws_connect_instance" "example" {
  name               = "example-connect-instance"
  identity_management_type = "CONNECT_MANAGED"
  inbound_call_routing_enabled = true
  outbound_call_routing_enabled = true
}

resource "aws_lex_bot" "example" {
  name                  = "example-lex-bot"
  description           = "Example Lex bot for AWS Connect"
  intent_versions       = ["example-intent"]
  child_intent_versions = []
  locale                = "en-US"
  child_lex_bot_names   = []
  voice_id              = "Joanna"
  create_version        = true
}

resource "aws_connect_bot_association" "example" {
  instance_arn = aws_connect_instance.example.arn
  bot_arn      = aws_lex_bot.example.arn
}
```


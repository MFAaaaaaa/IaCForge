[34:20m2026-07-07 20:45:53,267 - iac-eval - INFO - Model raw output: **Description of the Terraform Program:**

This Terraform configuration creates a managed Amazon MSK (Managed Streaming for Apache Kafka) cluster with both `jmx_exporter` and `node_exporter` enabled for monitoring. The configuration includes:

- A VPC with public and private subnets.
- An Internet Gateway for public access.
- A security group for the MSK cluster.
- An MSK cluster with a single broker node (you can scale as needed).
- IAM roles and policies to allow MSK to communicate with CloudWatch for metrics.
- Configuration for enabling `jmx_exporter` and `node_exporter` on the MSK cluster.

The configuration is designed to be deployed in the `us-east-1` region and uses default values for variables where applicable.

---

```hcl
provider "aws" {
  region = "us-east-1"
}

variable "vpc_cidr" {
  default = "10.0.0.0/16"
}

variable "public_subnets" {
  default = ["10.0.1.0/24", "10.0.2.0/24"]
}

variable "private_subnets" {
  default = ["10.0.3.0/24", "10.0.4.0/24"]
}

variable "msk_cluster_name" {
  default = "msk-cluster-jmx-node-exporter"
}

variable "msk_broker_count" {
  default = 1
}

variable "msk_kafka_version" {
  default = "3.3"
}

variable "msk_instance_type" {
  default = "kafka.m5.large"
}

resource "aws_vpc" "main" {
  cidr_block = var.vpc_cidr
  tags = {
    Name = "msk-vpc"
  }
}

resource "aws_internet_gateway" "main" {
  vpc_id = aws_vpc.main.id
  tags = {
    Name = "msk-igw"
  }
}

resource "aws_subnet" "public" {
  count = length(var.public_subnets)
  cidr_block = var.public_subnets[count.index]
  vpc_id     = aws_vpc.main.id
  map_public_ip_on_launch = true
  tags = {
    Name = "public-subnet-${count.index + 1}"
  }
}

resource "aws_subnet" "private" {
  count = length(var.private_subnets)
  cidr_block = var.private_subnets[count.index]
  vpc_id     = aws_vpc.main.id
  tags = {
    Name = "private-subnet-${count.index + 1}"
  }
}

resource "aws_security_group" "msk" {
  name        = "msk-sg"
  description = "Security group for MSK cluster"
  vpc_id      = aws_vpc.main.id

  ingress {
    from_port   = 9092
    to_port     = 9092
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "msk-sg"
  }
}

resource "aws_iam_role" "msk_role" {
  name = "msk-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = { Service = "kafka.amazonaws.com" }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "msk_cloudwatch" {
  role       = aws_iam_role.msk_role.name
  policy_arn = "arn:aws:iam::aws:policy/CloudWatchAgentServerPolicy"
}

resource "aws_msk_cluster" "main" {
  cluster_name           = var.msk_cluster_name
  kafka_version        = var.msk_kafka_version
  number_of_broker_nodes = var.msk_broker_count
  broker_node_group_info {
    instance_type = var.msk_instance_type
    client_subnets = [
      aws_subnet.public[0].id,
      aws_subnet.public[1].id,
    ]
    security_groups = [aws_security_group.msk.id]
    storage_info {
      ebs_storage_info {
        volume_size = 100
      }
    }
  }

  encryption_info {
    encryption_in_transit {
      in_cluster = true
      client_broker = "TLS"
    }
  }

  logging {
    broker_logs {
      cloudwatch_logs = true
      firehose        = false
      s3              = false
    }
  }

  open_monitoring {
    prometheus {
      jmx_exporter = true
      node_exporter = true
    }
  }

  tags = {
    Name = var.msk_cluster_name
  }
}

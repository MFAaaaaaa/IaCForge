This Terraform configuration creates a Kinesis Firehose Delivery Stream that delivers data to a Redshift cluster. The configuration includes:

- A Redshift cluster (with a default database and user).
- A Redshift IAM role that allows Firehose to write to the Redshift cluster.
- A Kinesis Firehose Delivery Stream that uses the Redshift cluster as a destination.
- A default VPC and subnet configuration to ensure the resources are deployed in a secure and isolated environment.

The configuration is designed to be self-contained and deployable with Terraform 1.9.8 and the AWS provider version 5.75.

---

```hcl
provider "aws" {
  region = "us-west-2"
}

resource "aws_redshift_cluster" "example" {
  cluster_identifier = "example-redshift-cluster"
  database_name      = "exampledb"
  master_username    = "admin"
  master_password    = "SecurePassword123!"
  node_type          = "dc2.large"
  cluster_type       = "single-node"
  skip_final_snapshot = true
}

resource "aws_iam_role" "firehose_redshift_role" {
  name = "firehose-redshift-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = { Service = "firehose.amazonaws.com" }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "firehose_redshift" {
  role       = aws_iam_role.firehose_redshift_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonRedshiftFullAccess"
}

resource "aws_iam_role_policy" "firehose_redshift_custom" {
  name = "firehose-redshift-custom-policy"
  role = aws_iam_role.firehose_redshift_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Action = [
        "redshift:DescribeClusters",
        "redshift:DescribeClusterSnapshots",
        "redshift:DescribeClusterParameterGroups"
      ]
      Resource = "*"
    }]
  })
}

resource "aws_kinesis_firehose_delivery_stream" "example" {
  name        = "example-firehose-stream"
  destination = "redshift"

  redshift_configuration {
    cluster_jdbcurl = "jdbc:redshift://${aws_redshift_cluster.example.endpoint}/exampledb"
    role_arn        = aws_iam_role.firehose_redshift_role.arn
    username        = "admin"
    password        = "SecurePassword123!"
    bucket_name     = "example-firehose-bucket"
    buffer_duration = 300
    buffer_size     = 5
    retry_duration  = 300
    s3_backup_mode  = "Enabled"
  }
}

[34:20m2026-07-07 20:12:39,443 - iac-eval - INFO - Model raw output: **Description of the Terraform Program:**

This Terraform configuration creates a Kinesis Firehose Delivery Stream that delivers data to an Elasticsearch destination within a VPC. The configuration includes:

- A VPC with a public and private subnet.
- An Internet Gateway (IGW) for the public subnet.
- A Route Table for the public subnet.
- A Security Group for the Elasticsearch domain.
- An Elasticsearch domain within the VPC.
- A Kinesis Firehose Delivery Stream with an Elasticsearch destination configured to use the Elasticsearch domain in the VPC.

The configuration ensures that the Firehose stream can securely deliver data to Elasticsearch within the VPC, using the appropriate IAM roles and network configurations.

---

```hcl
provider "aws" {
  region = "us-west-2"
}

resource "aws_vpc" "firehose_vpc" {
  cidr_block = "10.0.0.0/16"
  tags = {
    Name = "firehose-vpc"
  }
}

resource "aws_internet_gateway" "firehose_igw" {
  vpc_id = aws_vpc.firehose_vpc.id
  tags = {
    Name = "firehose-igw"
  }
}

resource "aws_subnet" "firehose_public_subnet" {
  vpc_id            = aws_vpc.firehose_vpc.id
  cidr_block        = "10.0.1.0/24"
  map_public_ip_on_launch = true
  availability_zone = "us-west-2a"
  tags = {
    Name = "firehose-public-subnet"
  }
}

resource "aws_route_table" "firehose_public_route_table" {
  vpc_id = aws_vpc.firehose_vpc.id
  tags = {
    Name = "firehose-public-route-table"
  }
}

resource "aws_route" "firehose_public_route" {
  route_table_id         = aws_route_table.firehose_public_route_table.id
  destination_cidr_block = "0.0.0.0/0"
  gateway_id             = aws_internet_gateway.firehose_igw.id
}

resource "aws_subnet" "firehose_private_subnet" {
  vpc_id            = aws_vpc.firehose_vpc.id
  cidr_block        = "10.0.2.0/24"
  availability_zone = "us-west-2a"
  tags = {
    Name = "firehose-private-subnet"
  }
}

resource "aws_security_group" "firehose_es_sg" {
  name        = "firehose-es-sg"
  description = "Allow traffic to Elasticsearch domain"
  vpc_id      = aws_vpc.firehose_vpc.id

  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["10.0.0.0/16"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "firehose-es-sg"
  }
}

resource "aws_elasticsearch_domain" "firehose_es_domain" {
  domain_name = "firehose-es-domain"
  elasticsearch_version = "7.10"
  cluster_config {
    instance_type = "t3.small.elasticsearch"
    instance_count = 1
  }
  vpc_options {
    security_group_ids = [aws_security_group.firehose_es_sg.id]
    subnet_ids = [aws_subnet.firehose_private_subnet.id]
  }
  tags = {
    Name = "firehose-es-domain"
  }
}

resource "aws_iam_role" "firehose_iam_role" {
  name = "firehose-iam-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = { Service = "firehose.amazonaws.com" }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "firehose_es_access" {
  role       = aws_iam_role.firehose_iam_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonESFullAccess"
}

resource "aws_kinesis_firehose_delivery_stream" "firehose_delivery_stream" {
  name        = "firehose-delivery-stream"
  destination = "elasticsearch"

  elasticsearch_destination_configuration {
    domain_arn = aws_elasticsearch_domain.firehose_es_domain.arn
    index_name = "firehose-index"
    role_arn   = aws_iam_role.firehose_iam_role.arn
    type_name  = "firehose-type"
  }

  tags = {
    Name = "firehose-delivery-stream"
  }
}

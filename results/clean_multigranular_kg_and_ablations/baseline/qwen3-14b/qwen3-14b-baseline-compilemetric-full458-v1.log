**Terraform HCL Program:**

```hcl
provider "aws" {
  region = "us-east-1"
}

resource "aws_lightsail_instance" "example" {
  name              = "tf-lightsail-instance"
  availability_zone = "us-east-1a"
  blueprint_id      = "app_wordpress"
  bundle_id         = "nano_1_0"
  tags = {

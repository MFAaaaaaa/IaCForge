[34:20m2026-07-07 20:13:14,694 - iac-eval - INFO - Model raw output: **Description of the Terraform Program:**

This Terraform configuration creates a Kinesis Firehose Delivery Stream that delivers data to an OpenSearch domain within a VPC. The configuration includes:

- An AWS VPC with a public and private subnet.
- An OpenSearch domain deployed in the private subnet.
- A Kinesis Firehose Delivery Stream that sends data to the OpenSearch domain.
- An IAM role and policy that allows Firehose to write to the OpenSearch domain.
- A provider configuration for AWS in the `us-east-1` region.

---

```hcl
provider "aws" {
  region = "us-east-1"
}

resource "aws_vpc" "firehose_vpc" {
  cidr_block = "10.0.0.0/16"
  tags = {
    Name = "firehose-vpc"
  }
}

resource "aws_subnet" "public_subnet" {
  vpc_id            = aws_vpc.firehose_vpc.id
  cidr_block        = "10.0.1.0/24"
  map_public_ip_on_launch = true
  availability_zone = "us-east-1a"
  tags = {
    Name = "firehose-public-subnet"
  }
}

resource "aws_subnet" "private_subnet" {
  vpc_id            = aws_vpc.firehose_vpc.id
  cidr_block        = "10.0.2.0/24"
  availability_zone = "us-east-1a"
  tags = {
    Name = "firehose-private-subnet"
  }
}

resource "aws_internet_gateway" "firehose_igw" {
  vpc_id = aws_vpc.firehose_vpc.id
  tags = {
    Name = "firehose-igw"
  }
}

resource "aws_route_table" "public_route_table" {
  vpc_id = aws_vpc.firehose_vpc.id
  tags = {
    Name = "firehose-public-route-table"
  }
}

resource "aws_route" "public_route" {
  route_table_id         = aws_route_table.public_route_table.id
  destination_cidr_block = "0.0.0.0/0"
  gateway_id             = aws_internet_gateway.firehose_igw.id
}

resource "aws_route_table_association" "public_subnet_assoc" {
  subnet_id      = aws_subnet.public_subnet.id
  route_table_id = aws_route_table.public_route_table.id
}

resource "aws_security_group" "firehose_opensearch_sg" {
  name        = "firehose-opensearch-sg"
  description = "Allow traffic from Firehose to OpenSearch"
  vpc_id      = aws_vpc.firehose_vpc.id

  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["10.0.0.0/16"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "firehose-opensearch-sg"
  }
}

resource "aws_opensearch_domain" "firehose_opensearch" {
  domain_name           = "firehose-opensearch"
  elasticsearch_version = "7.10"
  cluster_config {
    instance_type = "t3.small.search"
    instance_count = 1
  }
  vpc_options {
    security_group_ids = [aws_security_group.firehose_opensearch_sg.id]
    subnet_ids         = [aws_subnet.private_subnet.id]
  }
  tags = {
    Name = "firehose-opensearch"
  }
}

resource "aws_iam_role" "firehose_iam_role" {
  name = "firehose-opensearch-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = { Service = "firehose.amazonaws.com" }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "firehose_opensearch" {
  role       = aws_iam_role.firehose_iam_role.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSFirehoseOpenSearchAccess"
}

resource "aws_kinesis_firehose_delivery_stream" "firehose_stream" {
  name        = "firehose-to-opensearch"
  destination = "opensearch"

  opensearch_configuration {
    domain_arn = aws_opensearch_domain.firehose_opensearch.arn
    role_arn   = aws_iam_role.firehose_iam_role.arn
    index_name = "firehose-index"
    type_name  = "firehose-type"
    retry_duration = 30
  }

  tags = {
    Name = "firehose-to-opensearch"
  }
}

This Terraform configuration will create two AWS Linux instances (using the latest Amazon Linux 2 AMI) in private subnets. These instances will be placed in a VPC with a private subnet configuration, and they will share a common Amazon EFS (Elastic File System) file system. The EFS will be mounted on both instances, allowing them to access shared storage. The configuration includes a VPC, private subnets, an EFS file system, and the necessary IAM roles and security groups to enable communication between the instances and the EFS.

---

**Terraform HCL Code:**

```hcl
provider "aws" {
  region = "us-east-1"
}

variable "ami_id" {
  default = "ami-0aa702f6153034b3d" # Amazon Linux 2 (latest)
}

variable "instance_type" {
  default = "t3.micro"
}

variable "vpc_cidr" {
  default = "10.0.0.0/16"
}

variable "private_subnet_cidr" {
  default = "10.0.1.0/24"
}

variable "efs_mount_target_subnet" {
  default = "10.0.1.0/24"
}

resource "aws_vpc" "main" {
  cidr_block = var.vpc_cidr
  tags = {
    Name = "main-vpc"
  }
}

resource "aws_subnet" "private" {
  vpc_id            = aws_vpc.main.id
  cidr_block        = var.private_subnet_cidr
  map_public_ip_on_launch = false
  availability_zone = "us-east-1a"
  tags = {
    Name = "private-subnet"
  }
}

resource "aws_internet_gateway" "main" {
  vpc_id = aws_vpc.main.id
  tags = {
    Name = "main-igw"
  }
}

resource "aws_route_table" "private" {
  vpc_id = aws_vpc.main.id
  tags = {
    Name = "private-rt"
  }
}

resource "aws_route_table_association" "private" {
  subnet_id      = aws_subnet.private.id
  route_table_id = aws_route_table.private.id
}

resource "aws_security_group" "efs_sg" {
  name        = "efs-sg"
  description = "Allow EFS access"
  vpc_id      = aws_vpc.main.id

  ingress {
    from_port   = 2049
    to_port     = 2049
    protocol    = "tcp"
    cidr_blocks = [aws_vpc.main.cidr_block]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "efs-sg"
  }
}

resource "aws_efs_file_system" "shared" {
  creation_token = "shared-efs"
  tags = {
    Name = "shared-efs"
  }
}

resource "aws_efs_mount_target" "private" {
  file_system_id = aws_efs_file_system.shared.id
  subnet_id      = aws_subnet.private.id
  security_groups = [aws_security_group.efs_sg.id]
}

resource "aws_iam_role" "efs_role" {
  name = "efs-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = { Service = "ec2.amazonaws.com" }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "efs_role" {
  role       = aws_iam_role.efs_role.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonEFSReadOnlyAccess"
}

resource "aws_iam_role" "ec2_role" {
  name = "ec2-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = { Service = "ec2.amazonaws.com" }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "ec2_role" {
  role       = aws_iam_role.ec2_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
}

resource "aws_instance" "app" {
  count = 2
  ami = var.ami_id
  instance_type = var.instance_type
  subnet_id = aws_subnet.private.id
  vpc_security_group_ids = [aws_security_group.efs_sg.id]
  iam_instance_profile = aws_iam_role.ec2_role.name
  tags = {
    Name = "app-instance-${count.index + 1}"
  }

  user_data = <<-EOF
              #!/bin/bash
              yum update -y
              yum install -y amazon-efs-utils
              mkdir /efs
              mount -t efs ${aws_efs_file_system.shared.id}:/ /efs
              echo "/efs  $(aws efs describe-file-systems --file-system-id ${aws_efs_file_system.shared.id} --query 'FileSystems[0].FileSystemId' --output text):/  efs defaults 0 0" >> /etc/fstab
              EOF
}
```

---

**Notes:**

- This configuration assumes that the AWS region is `us-east-1` and that the latest Amazon Linux 2 AMI is used.
- The EFS file system is mounted on both instances using the `user_data` script.
- The EFS mount target is created in the same private subnet as the EC2 instances.
- The EC2 instances are assigned the `ec2-role` IAM role, which allows them to use AWS Systems Manager (SSM) and access the EFS file system.

You can apply this configuration using `terraform apply` after initializing the Terraform working directory. (eval.py:730)[0m

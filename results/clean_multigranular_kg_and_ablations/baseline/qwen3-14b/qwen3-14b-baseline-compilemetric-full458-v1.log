  parameter_group_name         = "default.redis6"
  security_group_ids           = [aws_security_group.redis_sg.id]
  subnet_group_name            = aws_elasticache_subnet_group.redis_subnet_group.name
  port                         = 6379
  auto_minor_version_upgrade = true
}

resource "aws_security_group" "redis_sg" {
  name        = "redis-sg"
  description = "Allow access to Redis cluster"
  vpc_id      = aws_vpc.main.id

  ingress {
    from_port   = 6379
    to_port     = 6379
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_vpc" "main" {
  cidr_block = "10.0.0.0/16"
}

resource "aws_subnet" "redis_subnet" {
  vpc_id            = aws_vpc.main.id
  cidr_block        = "10.0.1.0/24"
  availability_zone = "us-west-2a"
}

resource "aws_elasticache_subnet_group" "redis_subnet_group" {
  name       = "redis-subnet-group"
  subnet_ids = [aws_subnet.redis_subnet.id]
}

resource "aws_elasticache_user" "redis_user" {
  user_id         = "redis_user"
  user_name       = "redis_user"
  engine          = "redis"
  passwords       = ["SecurePassword123!"]
  access_string   = "on ~* +@all"
  no_password_required = false
}
```

**Notes:**
- The `aws_elasticache_user` resource is used to create a user for the Redis engine.
- The `passwords` field is a list of passwords for the user. The first password is used as the primary password.
- The `access_string` defines the permissions for the user. In this case, it grants full access (`+@all`).
- The `aws_elasticache_replication_group` is created with a single node in the `us-west-2a` availability zone.
- A VPC, subnet, and security group are created to support the ElastiCache cluster. (eval.py:730)[0m

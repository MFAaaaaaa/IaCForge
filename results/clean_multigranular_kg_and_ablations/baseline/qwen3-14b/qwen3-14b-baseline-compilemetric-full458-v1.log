[34:20m2026-07-07 20:00:08,480 - iac-eval - INFO - Model raw output: **Description of the Terraform Program:**

This Terraform configuration creates an Elastic Beanstalk environment that is linked to an Amazon RDS relational database instance. The RDS instance is named "default" and is configured with a basic setup, including a database name, username, and password. An IAM instance profile named "eb_ec2_profile" is created to allow the Elastic Beanstalk environment's EC2 instances to access the RDS instance securely. The configuration includes a provider block for AWS, a VPC, a subnet group, and the necessary IAM roles and policies to ensure secure and functional deployment.

---

```hcl
provider "aws" {
  region = "us-west-2"
}

resource "aws_db_instance" "default" {
  allocated_storage    = 20
  db_name              = "mydb"
  engine               = "mysql"
  engine_version       = "8.0.30"
  instance_class       = "db.t3.micro"
  username             = "admin"
  password             = "SecurePassword123!"
  db_subnet_group_name = aws_db_subnet_group.default.name
  vpc_security_group_ids = [aws_security_group.db_sg.id]
  skip_final_snapshot  = true
}

resource "aws_db_subnet_group" "default" {
  name       = "default-subnet-group"
  subnet_ids = [aws_subnet.private1.id, aws_subnet.private2.id]
}

resource "aws_vpc" "default" {
  cidr_block = "10.0.0.0/16"
}

resource "aws_subnet" "private1" {
  vpc_id            = aws_vpc.default.id
  cidr_block        = "10.0.1.0/24"
  map_public_ip_on_launch = false
  availability_zone = "us-west-2a"
}

resource "aws_subnet" "private2" {
  vpc_id            = aws_vpc.default.id
  cidr_block        = "10.0.2.0/24"
  map_public_ip_on_launch = false
  availability_zone = "us-west-2b"
}

resource "aws_security_group" "db_sg" {
  name        = "db-sg"
  description = "Allow database access"
  vpc_id      = aws_vpc.default.id

  ingress {
    from_port   = 3306
    to_port     = 3306
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_iam_role" "eb_ec2_profile" {
  name = "eb_ec2_profile"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = { Service = "ec2.amazonaws.com" }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "eb_ec2_profile_rds" {
  role       = aws_iam_role.eb_ec2_profile.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonRDSFullAccess"
}

resource "aws_iam_role_policy_attachment" "eb_ec2_profile_ec2" {
  role       = aws_iam_role.eb_ec2_profile.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonEC2ReadOnlyAccess"
}

resource "aws_elasticbeanstalk_environment" "default" {
  name                = "eb-env"
  application         = aws_elasticbeanstalk_application.default.name
  environment_name    = "eb-env"
  solution_stack_name = "64bit Amazon Linux 2023 v3.3.6 running Python 3.10"
  instance_profile    = aws_iam_role.eb_ec2_profile.arn
  database_password   = aws_db_instance.default.password
  database_username   = aws_db_instance.default.username
  database_name       = aws_db_instance.default.db_name
  database_type       = "mysql"
  database_engine_version = "8.0.30"
  database_instance_class = "db.t3.micro"
  db_subnet_group_name = aws_db_subnet_group.default.name
}

resource "aws_elasticbeanstalk_application" "default" {
  name = "eb-app"
}

---

**Terraform HCL Program:**

```hcl
provider "aws" {
  region = "us-east-1"
}

resource "aws_s3_bucket" "example_website_bucket" {
  bucket = "example-website-bucket-terraform"
  acl    = "public-read"

  website {
    index_document = "index.html"
    error_document = "error.html"
  }

  tags = {
    Name        = "example-website-bucket"
    Environment = "dev"
  }
}

resource "aws_s3_bucket_object" "index_html" {
  bucket = aws_s3_bucket.example_website_bucket.bucket
  key    = "index.html"
  content = <<EOF
<!DOCTYPE html>
<html>
  <head>
    <title>Example Website</title>
  </head>
  <body>
    <h1>Welcome to the Example Website!</h1>
    <p>This is a static website hosted on an S3 bucket.</p>
  </body>
</html>
EOF
  acl = "public-read"
}

resource "aws_s3_bucket_object" "error_html" {
  bucket = aws_s3_bucket.example_website_bucket.bucket
  key    = "error.html"
  content = <<EOF
<!DOCTYPE html>
<html>
  <head>
    <title>Error</title>
  </head>
  <body>
    <h1>404 - Page Not Found</h1>
    <p>The page you requested could not be found.</p>
  </body>
</html>
EOF
  acl = "public-read"
}
```


**Terraform HCL Program:**

```hcl
provider "aws" {
  region = "us-east-1"
}

resource "aws_iam_role" "codebuild_role" {
  name = "codebuild-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "codebuild.amazonaws.com"
      }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "codebuild_role_policy" {
  role       = aws_iam_role.codebuild_role.name
  policy_arn = "arn:aws:iam::aws:policy/AWSCodeBuildAdminAccess"
}

resource "aws_s3_bucket" "codebuild_artifacts" {
  bucket = "codebuild-artifacts-example"
  acl    = "private"
}

resource "aws_s3_bucket_policy" "codebuild_artifacts_policy" {
  bucket = aws_s3_bucket.codebuild_artifacts.bucket

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "codebuild.amazonaws.com"
      }
      Action = [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket"
      ]
      Resource = [
        aws_s3_bucket.codebuild_artifacts.arn,
        "${aws_s3_bucket.codebuild_artifacts.arn}/*"
      ]
    }]
  })
}

resource "aws_codebuild_project" "example" {
  name          = "example-codebuild-project"
  description   = "Example CodeBuild project with secondary artifacts"
  source {
    type      = "CODEPIPELINE"
    buildspec = "buildspec.yml"
  }

  artifacts {
    type = "CODEPIPELINE"
  }

  secondary_artifacts {
    name         = "secondary-artifact"
    type         = "S3"
    location     = aws_s3_bucket.codebuild_artifacts.bucket
    encryption_disabled = false
  }

  environment {
    type                = "LINUX_CONTAINER"
    image               = "aws/codebuild/amazonlinux2-x86_64-standard:3.0"
    compute_type        = "BUILD_GENERAL1_SMALL"
    environment_variables = {
      EXAMPLE_VAR = {
        name  = "EXAMPLE_VAR"
        value = "example-value"
        type  = "PLAINTEXT"
      }
    }
  }

  service_role = aws_iam_role.codebuild_role.arn
}
```


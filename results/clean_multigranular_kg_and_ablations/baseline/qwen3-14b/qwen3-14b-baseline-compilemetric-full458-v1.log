**Terraform HCL Code:**

```hcl
provider "aws" {
  region = "us-west-2"
}

resource "aws_s3_bucket" "mybucket" {
  bucket = "mybucket"
  acl    = "private"

  tags = {
    Name = "mybucket"
  }
}


provider "aws" {
  region = "us-east-1"
}

resource "aws_sagemaker_domain" "example" {
  domain_name           = "example-domain"
  auth_mode             = "SSO"
  default_user_settings {
    execution_role    = aws_iam_role.sagemaker_space_role.arn
    security_groups   = [aws_security_group.sagemaker_space_sg.id]
    sageMakerStudioAppSettings {
      default_resource_limits {
        instance_count = 1
        max_instance_count = 2
      }
    }
  }
}

resource "aws_iam_role" "sagemaker_space_role" {
  name = "sagemaker-space-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = { Service = "sagemaker.amazonaws.com" }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "sagemaker_space_role_policy" {
  role       = aws_iam_role.sagemaker_space_role.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonSageMakerExecutionRole"
}

resource "aws_security_group" "sagemaker_space_sg" {
  name        = "sagemaker-space-sg"
  description = "Security group for SageMaker Space"
  vpc_id      = aws_vpc.default.id

  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_vpc" "default" {
  cidr_block = "10.0.0.0/16"
}

resource "aws_sagemaker_space" "example" {
  domain_id         = aws_sagemaker_domain.example.id
  space_name        = "example-space"
  space_display_name = "Example Space"
  tags = {
    Environment = "dev"
  }
}
```

---


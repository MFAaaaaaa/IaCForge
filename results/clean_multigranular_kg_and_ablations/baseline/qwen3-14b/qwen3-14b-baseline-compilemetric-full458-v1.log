This Terraform configuration will create two AWS Chime Voice Connectors, each with encryption enabled. It will then create an AWS Chime Voice Connector Group that includes both connectors, with one connector designated as the prioritized one. The configuration includes a provider block for AWS, default region, and necessary variables with defaults to ensure it is deployable with Terraform 1.9.8 and the AWS provider version 5.75.

---

**Terraform HCL Code:**

```hcl
provider "aws" {
  region = "us-east-1"
  version = "~> 5.75"
}

variable "voice_connector_1_name" {
  description = "Name of the first voice connector"
  default     = "vc-connector-1"
}

variable "voice_connector_2_name" {
  description = "Name of the second voice connector"
  default     = "vc-connector-2"
}

variable "voice_connector_group_name" {
  description = "Name of the voice connector group"
  default     = "vc-group"
}

variable "priority_connector" {
  description = "Name of the connector to be prioritized"
  default     = "vc-connector-1"
}

resource "aws_chime_voice_connector" "connector_1" {
  name                = var.voice_connector_1_name
  encryption_required = true
}

resource "aws_chime_voice_connector" "connector_2" {
  name                = var.voice_connector_2_name
  encryption_required = true
}

resource "aws_chime_voice_connector_group" "group" {
  name = var.voice_connector_group_name

  voice_connector_items {
    voice_connector_id = aws_chime_voice_connector.connector_1.id
    priority           = 1
  }

  voice_connector_items {
    voice_connector_id = aws_chime_voice_connector.connector_2.id
    priority           = 2
  }
}
```

---


```hcl
provider "aws" {
  region = "us-west-2"
}

variable "cluster_identifier" {
  default = "example-redshift-cluster"
}

variable "cluster_type" {
  default = "single-node"
}

variable "node_type" {
  default = "dc2.large"
}

variable "master_username" {
  default = "admin"
}

variable "master_password" {
  default = "SecurePassword123!"
}

variable "sns_topic_name" {
  default = "redshift-parameter-group-events"
}

resource "aws_redshift_parameter_group" "example" {
  name        = "example-redshift-param-group"
  family      = "redshift-1.0"
  description = "Example Redshift parameter group for event notifications"

  parameter {
    name  = "query_execution_timeout"
    value = "300"
  }

  parameter {
    name  = "max_connections"
    value = "100"
  }
}

resource "aws_sns_topic" "example" {
  name = var.sns_topic_name
}

resource "aws_iam_role" "redshift_sns_role" {
  name = "redshift-sns-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = { Service = "redshift.amazonaws.com" }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "sns_publish" {
  role       = aws_iam_role.redshift_sns_role.name
  policy_arn = "arn:aws:iam::aws:policy/AWSLambda_SNS_PublishAccess"
}

resource "aws_redshift_event_subscription" "example" {
  name                = "redshift-event-subscription"
  sns_topic_arn       = aws_sns_topic.example.arn
  source_type         = "parameter-group"
  source_ids          = [aws_redshift_parameter_group.example.name]
  event_categories    = ["parameter-group"]
  enabled             = true
  tags = {
    Name = "Redshift Parameter Group Events"
  }
}

resource "aws_redshift_cluster" "example" {
  cluster_identifier     = var.cluster_identifier
  cluster_type           = var.cluster_type
  node_type              = var.node_type
  master_username        = var.master_username
  master_password        = var.master_password
  db_name                = "exampledb"
  cluster_parameter_group_name = aws_redshift_parameter_group.example.name
  iam_roles              = [aws_iam_role.redshift_sns_role.arn]
  skip_final_snapshot    = true
  tags = {
    Name = "Example Redshift Cluster"
  }
}

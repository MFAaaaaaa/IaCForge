  application_name = aws_elasticbeanstalk_application.example_app.name

  service_role_arn = aws_iam_role.example_iam_role.arn

  max_age_in_days = 30
  max_count       = 5
}

resource "aws_iam_role" "example_iam_role" {
  name = "example-eb-lifecycle-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "elasticbeanstalk.amazonaws.com"
      }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "example_iam_role_policy" {

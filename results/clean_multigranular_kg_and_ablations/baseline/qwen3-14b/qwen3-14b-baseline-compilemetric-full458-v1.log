[34:20m2026-07-07 20:07:58,920 - iac-eval - INFO - Model raw output: **Description of the Terraform Program:**

This Terraform configuration creates an AWS Lex V2 bot that allows users to order a pizza. The bot includes an intent for ordering a pizza and a follow-up question to confirm the order. The configuration includes the necessary resources such as the bot, intents, slots, and utterances. It also sets up the AWS provider with a valid region and includes a default IAM role for the bot to operate within AWS.

---

```hcl
provider "aws" {
  region = "us-east-1"
}

resource "aws_lexv2_bot" "pizza_bot" {
  name                     = "PizzaOrderBot"
  description              = "A bot for ordering pizza with a follow-up question"
  role_arn                 = aws_iam_role.iam_for_lex.arn
  idle_session_ttl_in_seconds = 300
  voice_id                 = "Joanna"
  data_privacy {
    child_directed = false
  }
  bot_version              = "DRAFT"
  locale_id                = "en-US"
  test_bot_configuration {
    bot_alias_status = "ENABLED"
  }
}

resource "aws_lexv2_bot_alias" "pizza_bot_alias" {
  bot_id      = aws_lexv2_bot.pizza_bot.id
  bot_version = aws_lexv2_bot.pizza_bot.bot_version
  name        = "PizzaOrderAlias"
  description = "Alias for the Pizza Order Bot"
  bot_alias_status = "ENABLED"
}

resource "aws_lexv2_intent" "order_pizza_intent" {
  name        = "OrderPizza"
  description = "Intent to order a pizza"
  bot_id      = aws_lexv2_bot.pizza_bot.id
  locale_id   = "en-US"
  slots {
    name        = "PizzaType"
    description = "Type of pizza"
    slot_type   = "AMAZON.Food"
    value_elicitation_prompt {
      message {
        content = "What type of pizza would you like?"
        content_type = "PlainText"
      }
      max_attempts = 2
    }
  }
  sample_utterances = [
    "I want to order a pizza",
    "Can I order a pizza?",
    "I need to order a pizza",
  ]
  fulfillment {
    code_hook {
      lambda_arn = aws_lambda_function.pizza_order_lambda.arn
    }
  }
}

resource "aws_lexv2_intent" "confirm_order_intent" {
  name        = "ConfirmOrder"
  description = "Intent to confirm the order"
  bot_id      = aws_lexv2_bot.pizza_bot.id
  locale_id   = "en-US"
  slots {
    name        = "ConfirmOrder"
    description = "Confirm the order"
    slot_type   = "AMAZON.Boolean"
    value_elicitation_prompt {
      message {
        content = "Would you like to confirm your order?"
        content_type = "PlainText"
      }
      max_attempts = 2
    }
  }
  sample_utterances = [
    "Yes, confirm the order",
    "I want to confirm my order",
    "Can you confirm my order?",
  ]
  fulfillment {
    code_hook {
      lambda_arn = aws_lambda_function.pizza_order_lambda.arn
    }
  }
}

resource "aws_iam_role" "iam_for_lex" {
  name = "lex-role-pizza-bot"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "lexv2.amazonaws.com"
      }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "iam_for_lex" {
  role       = aws_iam_role.iam_for_lex.name
  policy_arn = "arn:aws:iam::aws:policy/AWSLexFullAccess"
}

resource "aws_lambda_function" "pizza_order_lambda" {
  function_name    = "PizzaOrderLambda"
  role             = aws_iam_role.iam_for_lex.arn
  handler          = "index.handler"
  runtime          = "nodejs18.x"
  filename         = "lambda_function.zip"
  source_code_hash = filebase64sha256("lambda_function.zip")
  timeout          = 30
  memory_size      = 128
  publish          = true
}
```

---

**Note:** This configuration assumes that you have a `lambda_function.zip` file containing the Lambda function code for handling the pizza order and confirmation logic. You will need to create and package this Lambda function separately and upload it to AWS. The Lambda function should be written in Node.js and should handle the `OrderPizza` and `ConfirmOrder` intents. (eval.py:730)[0m

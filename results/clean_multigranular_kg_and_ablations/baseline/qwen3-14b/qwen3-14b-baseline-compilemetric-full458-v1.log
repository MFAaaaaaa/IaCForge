  }
}

resource "aws_security_group" "lightsail_sg" {
  name        = "lightsail-sg"
  description = "Allow SSH access to Lightsail instance"

  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "lightsail-sg"
  }
}
```


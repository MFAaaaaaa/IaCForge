**Terraform HCL Program:**

```hcl
provider "aws" {
  region = "us-west-2"
}

resource "aws_iam_user" "elasti_cache_user" {
  name = "elasti_cache_iam_user"
}

resource "aws_iam_user_policy_attachment" "elasti_cache_user_policy" {
  user       = aws_iam_user.elasti_cache_user.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonElastiCacheReadOnlyAccess"
}

resource "aws_elasticache_cluster" "example" {
  cluster_id           = "my-cluster"
  engine               = "redis"
  engine_version       = "6.x"
  node_type            = "cache.t2.micro"
  num_cache_nodes      = 1
  parameter_group_name = "default.redis6.x"
  port                 = 6379
  subnet_group_name    = "default"
  security_group_ids   = [aws_security_group.elasti_cache_sg.id]
  iam_authentication   = true
}

resource "aws_security_group" "elasti_cache_sg" {
  name        = "elasti_cache_sg"
  description = "ElastiCache Security Group"
  vpc_id      = "vpc-12345678"

  ingress {
    from_port   = 6379
    to_port     = 6379
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_elasticache_user" "example" {
  user_id         = "my_elasti_cache_user"
  engine          = "redis"
  access_string   = "on ~app~ * +@all"
  passwords       = ["SecurePassword123!"]
  iam_user_name   = aws_iam_user.elasti_cache_user.name
  no_password_required = false
}
```


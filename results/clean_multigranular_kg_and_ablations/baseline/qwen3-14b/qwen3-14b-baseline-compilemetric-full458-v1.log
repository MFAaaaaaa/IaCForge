This Terraform configuration sets up the following AWS resources to manage a domain using Amazon Route 53 and direct traffic to an Elastic Beanstalk environment:

1. **Route 53 Hosted Zone**: A hosted zone named "main" is created to manage the domain.
2. **Elastic Beanstalk Environment**: An environment named "eb-env" is created to host the application.
3. **IAM Role and Instance Profile**: An IAM role named "eb_ec2_role" and an instance profile named "eb_ec2_profile" are created to grant permissions to the Elastic Beanstalk environment.
4. **S3 Bucket**: A unique S3 bucket is created to store the application version.
5. **S3 Object**: An object named "examplebucket_object" is uploaded to the S3 bucket.
6. **Elastic Beanstalk Application and Version**: An application named "myapp" is created, and a version named "version" is uploaded from the S3 bucket.

All resources are configured with default values and valid provider settings in the `us-east-1` region.

---

**Terraform HCL Code:**

```hcl
provider "aws" {
  region = "us-east-1"
}

# Create a Route 53 Hosted Zone
resource "aws_route53_zone" "main" {
  name = "example.com"
}

# Create an IAM Role for Elastic Beanstalk
resource "aws_iam_role" "eb_ec2_role" {
  name = "eb_ec2_role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = { Service = "elasticbeanstalk.amazonaws.com" }
      Action = "sts:AssumeRole"
    }]
  })
}

# Create an IAM Instance Profile for Elastic Beanstalk
resource "aws_iam_instance_profile" "eb_ec2_profile" {
  name = "eb_ec2_profile"
  role = aws_iam_role.eb_ec2_role.name
}

# Create an S3 Bucket with a unique name
resource "aws_s3_bucket" "examplebucket" {
  bucket = "examplebucket-${random_string.unique_id.result}"
  acl    = "private"
}

resource "random_string" "unique_id" {
  length  = 8
  special = false
}

# Upload an object to the S3 bucket
resource "aws_s3_object" "examplebucket_object" {
  bucket = aws_s3_bucket.examplebucket.bucket
  key    = "example.txt"
  content = "This is an example object."
}

# Create an Elastic Beanstalk Application
resource "aws_elasticbeanstalk_application" "myapp" {
  name        = "myapp"
  description = "My Elastic Beanstalk Application"
}

# Create an Elastic Beanstalk Application Version
resource "aws_elasticbeanstalk_application_version" "version" {
  application = aws_elasticbeanstalk_application.myapp.name
  name        = "version"
  bucket      = aws_s3_bucket.examplebucket.bucket
  key         = aws_s3_object.examplebucket_object.key
  description = "My Elastic Beanstalk Application Version"
}

# Create an Elastic Beanstalk Environment
resource "aws_elasticbeanstalk_environment" "eb_env" {
  name                = "eb-env"
  application         = aws_elasticbeanstalk_application.myapp.name
  environment_name    = "eb-env"
  solution_stack_name = "64bit Amazon Linux 2023 v3.3.10 running Python 3.10"
  tier                = "WebServer"
  instance_profile    = aws_iam_instance_profile.eb_ec2_profile.name
  version_label       = aws_elasticbeanstalk_application_version.version.name
}
```


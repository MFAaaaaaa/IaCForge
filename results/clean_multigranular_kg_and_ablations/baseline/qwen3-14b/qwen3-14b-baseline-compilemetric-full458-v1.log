This Terraform configuration creates a basic Amazon Kinesis Analytics Application that processes data from a Kinesis Data Stream and logs the results to a CloudWatch Logs stream. The configuration includes:

- An AWS Kinesis Data Stream to act as the input source.
- An AWS Kinesis Analytics Application that reads from the Kinesis Data Stream.
- A CloudWatch Logs group and log stream to capture the application's output.
- An IAM role and policy to allow the Kinesis Analytics Application to write logs to CloudWatch.

The configuration is designed to be simple and self-contained, with default values for all variables to ensure it can be deployed without modification.

---

```hcl
provider "aws" {
  region = "us-east-1"
}

resource "aws_kinesis_stream" "example" {
  name             = "kinesis-stream-example"
  shard_count      = 1
  retention_period = 24
}

resource "aws_iam_role" "kinesis_analytics_role" {
  name = "kinesis-analytics-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "kinesisanalytics.amazonaws.com"
      }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "kinesis_analytics_logs" {
  role       = aws_iam_role.kinesis_analytics_role.name
  policy_arn = "arn:aws:iam::aws:policy/CloudWatchLambdaInsightsExecutionRolePolicy"
}

resource "aws_cloudwatch_log_group" "example" {
  name = "/kinesis-analytics-logs"
}

resource "aws_cloudwatch_log_stream" "example" {
  name      = "kinesis-analytics-log-stream"
  log_group_name = aws_cloudwatch_log_group.example.name
}

resource "aws_kinesisanalyticsv2_application" "example" {
  name = "kinesis-analytics-app"

  application_configuration {
    sql_application_configuration {
      input {
        name_prefix = "input"
        kinesis_streams_input {
          resource_arn = aws_kinesis_stream.example.arn
          role_arn     = aws_iam_role.kinesis_analytics_role.arn
        }
      }

      output {
        name = "output"
        cloudwatch_logs_output {
          log_stream_arn = aws_cloudwatch_log_stream.example.arn
          role_arn       = aws_iam_role.kinesis_analytics_role.arn
        }
      }

      sql_query = "SELECT * FROM STREAM(\"input\");"
    }
  }

  service_execution_role = aws_iam_role.kinesis_analytics_role.arn
}
``` (eval.py:730)[0m

This Terraform configuration creates a DynamoDB table with global replication across two AWS regions: `us-east-2` and `us-west-2`. The table will be provisioned with a primary key and will be configured with appropriate IAM permissions to allow the AWS service to manage the table. The configuration includes a provider block for AWS, a DynamoDB table resource with replication, and an IAM role for the DynamoDB service to operate in the specified regions.

---

**Terraform HCL Code:**

```hcl
provider "aws" {
  region = "us-east-2"
}

resource "aws_dynamodb_table" "example" {
  name           = "example-table"
  billing_mode   = "PAY_PER_REQUEST"
  hash_key       = "id"
  read_capacity  = 5
  write_capacity = 5

  attribute {
    name = "id"
    type = "S"
  }

  replication_group {
    region = "us-east-2"
  }

  replication_group {
    region = "us-west-2"
  }
}

resource "aws_iam_role" "dynamodb_service_role" {
  name = "dynamodb-service-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "dynamodb.amazonaws.com"
      }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "dynamodb_service_role" {
  role       = aws_iam_role.dynamodb_service_role.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonDynamoDBServiceRole"
}
```

---

**Notes:**


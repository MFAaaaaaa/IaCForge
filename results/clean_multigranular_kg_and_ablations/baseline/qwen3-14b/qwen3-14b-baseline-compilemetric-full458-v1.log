[34:20m2026-07-07 20:15:00,998 - iac-eval - INFO - Model raw output: **Description of the Terraform Program:**

This Terraform configuration creates an AWS Kendra data source with specific inclusion and exclusion patterns for document URLs. The data source is configured to index documents from a specified S3 bucket, and it includes and excludes URLs based on the provided patterns. The configuration includes a provider block for AWS, a Kendra index, and a Kendra data source with the required settings.

---

```hcl
provider "aws" {
  region = "us-east-1"
}

resource "aws_kendra_index" "example" {
  name                       = "example-kendra-index"
  description                = "Example Kendra index for document search"
  edition                    = "DEVELOPER_EDITION"
  language                   = "en"
  role_arn                   = aws_iam_role.kendra_role.arn
  user_group_resolution_configuration {
    user_group_resolution_mode = "NONE"
  }
}

resource "aws_iam_role" "kendra_role" {
  name = "kendra-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "kendra.amazonaws.com"
      }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "kendra-service-role" {
  role       = aws_iam_role.kendra_role.name
  policy_arn = "arn:aws:iam::aws:policy/AWSKendraFullAccess"
}

resource "aws_kendra_data_source" "example" {
  name             = "example-kendra-data-source"
  index_id         = aws_kendra_index.example.id
  type             = "S3"
  s3_configuration {
    bucket_name = "example-bucket"
    access_key  = "example-access-key"
    secret_key  = "example-secret-key"
  }
  inclusion_patterns = [
    "https://example.com/data/*",
    "https://example.com/reports/*.pdf"
  ]
  exclusion_patterns = [
    "https://example.com/data/temp/*",
    "https://example.com/reports/*.txt"
  ]
}
```

---

**Notes:**

- Replace `"example-bucket"`, `"example-access-key"`, and `"example-secret-key"` with actual S3 bucket and credentials.
- The `role_arn` for the Kendra index is set to the ARN of the IAM role created in this configuration.

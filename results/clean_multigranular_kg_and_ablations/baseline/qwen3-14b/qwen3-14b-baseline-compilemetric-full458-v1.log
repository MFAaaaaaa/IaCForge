**Terraform HCL Code:**

```hcl
provider "aws" {
  region = "us-west-2"
}

resource "aws_key_pair" "example_key_pair" {
  public_key = file("./key.pub")
  name       = "example-key-pair"
}

resource "aws_instance" "example_instance" {
  ami           = "ami-0aa16b0b2f70c3595" # Amazon Linux 2023 x86-64
  instance_type = "t2.micro"
  key_name      = aws_key_pair.example_key_pair.name
  tags = {
    Name = "example-instance"
  }
}

resource "aws_backup_vault" "example_vault" {
  name                = "example-backup-vault"
  deletion_window_in_days = 7
}

resource "aws_iam_role" "backup_role" {
  name = "backup-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "backup.amazonaws.com"
      }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "backup_role_policy" {
  role       = aws_iam_role.backup_role.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSBackupServiceRolePolicyForBackup"
}

resource "aws_backup_plan" "example_plan" {
  name = "example-backup-plan"

  rule {
    rule_name         = "daily-backup"
    schedule          = "0 0 * * ? *"
    target_vault_name = aws_backup_vault.example_vault.name
    start_window_minutes = 60
    window_minutes       = 60

    lifecycle {
      delete_after = 7
    }

    advanced_backup_setting {
      resource_type = "EC2"
    }
  }
}

resource "aws_backup_selection" "example_selection" {
  name = "example-backup-selection"
  plan_id = aws_backup_plan.example_plan.id

  selection_tag {
    key   = "Name"
    value = "example-instance"
  }

  resources = [
    aws_instance.example_instance.arn
  ]

  iam_role_arn = aws_iam_role.backup_role.arn
}
```

---

This configuration is fully self-contained and can be deployed with Terraform version `~> 1.9.8` and the AWS provider version `~> 5.75`. Ensure that the file `./key.pub` exists in the working directory before applying the configuration. (eval.py:730)[0m

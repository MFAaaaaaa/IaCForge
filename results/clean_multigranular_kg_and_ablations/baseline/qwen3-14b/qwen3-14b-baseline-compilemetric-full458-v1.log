[34:20m2026-07-07 20:54:43,707 - iac-eval - INFO - Model raw output: **Description of the Terraform Program:**

This Terraform configuration sets up a basic AWS Neptune cluster with a custom parameter group. The custom parameter group is configured to restrict access to the Neptune cluster to only two example subnets. The configuration includes:

- An AWS Neptune cluster with a single instance.
- A custom Neptune parameter group that modifies the `allow_connections_from` parameter to restrict access to the specified subnets.
- A VPC with two example subnets (public or private, depending on your use case).
- A security group that allows traffic from the specified subnets to the Neptune cluster.

The configuration is designed to be deployed in the `us-east-1` region and uses default values for variables where applicable.

---

**Terraform HCL Code:**

```hcl
provider "aws" {
  region = "us-east-1"
}

variable "neptune_instance_type" {
  description = "The instance type for the Neptune cluster"
  default     = "db.r5.large"
}

variable "neptune_engine_version" {
  description = "The engine version for the Neptune cluster"
  default     = "1.2.8.1"
}

variable "neptune_cluster_name" {
  description = "The name of the Neptune cluster"
  default     = "neptune-cluster"
}

variable "neptune_db_name" {
  description = "The name of the Neptune database"
  default     = "neptunedb"
}

variable "neptune_subnet_ids" {
  description = "List of subnet IDs that are allowed to connect to the Neptune cluster"
  default     = ["subnet-12345678", "subnet-87654321"]
}

variable "vpc_cidr" {
  description = "CIDR block for the VPC"
  default     = "10.0.0.0/16"
}

variable "subnet1_cidr" {
  description = "CIDR block for the first subnet"
  default     = "10.0.1.0/24"
}

variable "subnet2_cidr" {
  description = "CIDR block for the second subnet"
  default     = "10.0.2.0/24"
}

resource "aws_vpc" "neptune_vpc" {
  cidr_block = var.vpc_cidr
  tags = {
    Name = "neptune-vpc"
  }
}

resource "aws_subnet" "neptune_subnet1" {
  vpc_id            = aws_vpc.neptune_vpc.id
  cidr_block        = var.subnet1_cidr
  availability_zone = "us-east-1a"
  tags = {
    Name = "neptune-subnet1"
  }
}

resource "aws_subnet" "neptune_subnet2" {
  vpc_id            = aws_vpc.neptune_vpc.id
  cidr_block        = var.subnet2_cidr
  availability_zone = "us-east-1b"
  tags = {
    Name = "neptune-subnet2"
  }
}

resource "aws_db_parameter_group" "neptune_custom_param_group" {
  name        = "neptune-custom-param-group"
  family      = "neptune1.2"
  description = "Custom parameter group for Neptune cluster with subnet restrictions"

  parameter {
    name  = "allow_connections_from"
    value = join(",", var.neptune_subnet_ids)
  }
}

resource "aws_db_subnet_group" "neptune_subnet_group" {
  name       = "neptune-subnet-group"
  subnet_ids = [aws_subnet.neptune_subnet1.id, aws_subnet.neptune_subnet2.id]
  description = "Subnet group for Neptune cluster"
}

resource "aws_neptune_cluster" "neptune_cluster" {
  cluster_identifier      = var.neptune_cluster_name
  engine                  = "neptune"
  engine_version          = var.neptune_engine_version
  db_subnet_group_name    = aws_db_subnet_group.neptune_subnet_group.name
  parameter_group_name    = aws_db_parameter_group.neptune_custom_param_group.name
  skip_final_snapshot     = true
  storage_encrypted       = true
  apply_immediately       = true
  backup_retention_period = 5
  preferred_backup_window = "01:00-02:00"
  tags = {
    Name = var.neptune_cluster_name
  }
}

resource "aws_neptune_cluster_instance" "neptune_instance" {
  cluster_identifier = aws_neptune_cluster.neptune_cluster.id
  instance_class     = var.neptune_instance_type
  tags = {
    Name = "neptune-instance"
  }
}
```

---

**Notes:**

- Replace the example subnet IDs (`"subnet-12345678"`, `"subnet-87654321"`) with actual subnet IDs from your AWS environment if you are deploying this in a real environment.
- This configuration assumes that the subnets are in the same region (`us-east-1`) and are part of the same VPC.
- The `allow_connections_from` parameter is specific to Neptune and is used to restrict access to the cluster from specific subnets. (eval.py:730)[0m

This Terraform configuration creates an AWS Lex Bot named "PizzaOrderBot" with 5 different intents, each designed to handle a specific part of the pizza ordering process. The intents include:

1. `OrderPizza` – To initiate the pizza ordering process.
2. `ChooseSize` – To select the size of the pizza.
3. `ChooseToppings` – To select toppings for the pizza.
4. `ChooseCrust` – To choose the type of crust.
5. `ConfirmOrder` – To confirm the order details.

The configuration includes a provider block for AWS, sets the region to `us-east-1`, and defines the Lex bot with its intents, slots, and utterances. It also creates an IAM role for the Lex bot to ensure it has the necessary permissions to operate within AWS.

---

**Terraform HCL Code:**

```hcl
provider "aws" {
  region = "us-east-1"
}

resource "aws_iam_role" "lex_bot_role" {
  name = "lex-bot-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "lex.amazonaws.com"
      }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "lex_bot_policy" {
  role       = aws_iam_role.lex_bot_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonLexFullAccess"
}

resource "aws_lex_bot" "pizza_order_bot" {
  name                     = "PizzaOrderBot"
  description              = "A bot for ordering pizzas"
  role_arn                 = aws_iam_role.lex_bot_role.arn
  child_directed           = false
  create_version           = true
  idle_session_ttl_in_seconds = 300
  process_behavior         = "REPLACE"

  intent {
    intent_name = "OrderPizza"
    slots = {
      "order_id" = {
        name        = "order_id"
        description = "Unique order ID"
        slot_type   = "AMAZON.NUMBER"
        value_elicitation_prompt = {
          message = {
            content = "Please provide your order ID."
            content_type = "PlainText"
          }
        }
      }
    }
    sample_utterances = [
      "I want to order a pizza",
      "Let me place an order"
    ]
  }

  intent {
    intent_name = "ChooseSize"
    slots = {
      "size" = {
        name        = "size"
        description = "Size of the pizza"
        slot_type   = "AMAZON.NUMBER"
        value_elicitation_prompt = {
          message = {
            content = "What size would you like?"
            content_type = "PlainText"
          }
        }
      }
    }
    sample_utterances = [
      "I want a large pizza",
      "Make it medium"
    ]
  }

  intent {
    intent_name = "ChooseToppings"
    slots = {
      "toppings" = {
        name        = "toppings"
        description = "Toppings for the pizza"
        slot_type   = "AMAZON.LIST"
        value_elicitation_prompt = {
          message = {
            content = "What toppings would you like?"
            content_type = "PlainText"
          }
        }
      }
    }
    sample_utterances = [
      "Add pepperoni and mushrooms",
      "I want extra cheese"
    ]
  }

  intent {
    intent_name = "ChooseCrust"
    slots = {
      "crust" = {
        name        = "crust"
        description = "Type of crust"
        slot_type   = "AMAZON.LIST"
        value_elicitation_prompt = {
          message = {
            content = "What type of crust would you like?"
            content_type = "PlainText"
          }
        }
      }
    }
    sample_utterances = [
      "I want thin crust",
      "Make it deep dish"
    ]
  }

  intent {
    intent_name = "ConfirmOrder"
    slots = {
      "confirmation" = {
        name        = "confirmation"
        description = "Order confirmation"
        slot_type   = "AMAZON.BOOLEAN"
        value_elicitation_prompt = {
          message = {
            content = "Is this correct?"
            content_type = "PlainText"
          }
        }
      }
    }
    sample_utterances = [
      "Yes, that's correct",
      "I confirm my order"
    ]
  }
}
```


This Terraform configuration creates an Elastic Beanstalk worker environment designed to run batch processing jobs. It includes the following components:

- An IAM role (`eb_ec2_role`) and instance profile (`eb_ec2_profile`) for the Elastic Beanstalk EC2 instances.
- An Elastic Beanstalk application (`batch_job_app`) and an application version (`version`) for deploying the worker environment.
- An S3 bucket (`sampleapril26426`) and an object (`examplebucket_object`) for storing application code or logs.
- An SQS queue (`batch_job_queue`) for handling batch job messages.

The configuration ensures that all necessary resources are created and properly linked, with default values provided for any variables used.

---

**Terraform HCL Code:**

```hcl
provider "aws" {
  region = "us-east-1"
}

resource "aws_iam_role" "eb_ec2_role" {
  name = "eb_ec2_role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = { Service = "ec2.amazonaws.com" }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_instance_profile" "eb_ec2_profile" {
  name = "eb_ec2_profile"
  roles = [aws_iam_role.eb_ec2_role.name]
}

resource "aws_iam_role_policy_attachment" "ec2_role" {
  role       = aws_iam_role.eb_ec2_role.name
  policy_arn = "arn:aws:iam::aws:policy/AWSLambdaBasicExecutionRole"
}

resource "aws_s3_bucket" "sampleapril26426" {
  bucket = "sampleapril26426"
  acl    = "private"
}

resource "aws_s3_bucket_object" "examplebucket_object" {
  bucket = aws_s3_bucket.sampleapril26426.bucket
  key    = "example.txt"
  content = "This is an example object."
}

resource "aws_sqs_queue" "batch_job_queue" {
  name = "batch_job_queue"
}

resource "aws_elasticbeanstalk_application" "batch_job_app" {
  name = "batch_job_app"
}

resource "aws_elasticbeanstalk_application_version" "version" {
  application = aws_elasticbeanstalk_application.batch_job_app.name
  name        = "version"
  description = "Initial version of the batch job application"
  bucket      = aws_s3_bucket.sampleapril26426.bucket
  key         = aws_s3_bucket_object.examplebucket_object.key
}

resource "aws_elasticbeanstalk_environment" "worker_env" {
  name                = "batch-worker-env"
  application         = aws_elasticbeanstalk_application.batch_job_app.name
  environment_name    = "batch-worker-env"
  solution_stack_name = "64bit Amazon Linux 2023 v3.3.10 running Python 3.10"
  tier                = "worker"
  deployment_policy {
    type = "rolling"
  }
  setting {
    namespace = "aws:elasticbeanstalk:environment:process:default"
    name      = "Queue"
    value     = aws_sqs_queue.batch_job_queue.arn
  }
  setting {
    namespace = "aws:elasticbeanstalk:environment:managed_updates"
    name      = "ManagedUpdatesEnabled"
    value     = "true"
  }
  instance_profile = aws_iam_instance_profile.eb_ec2_profile.name
}
```


This Terraform configuration creates a Kinesis Firehose Delivery Stream with an extended S3 destination. The delivery stream is configured to deliver data to an S3 bucket, and includes advanced settings such as buffering hints, compression format, and error logging. An IAM role is created to allow Firehose to write to the S3 bucket. The configuration includes a provider block for AWS, a default region, and all necessary resources and variables with default values.

---

```hcl
provider "aws" {
  region = "us-west-2"
}

variable "s3_bucket_name" {
  description = "Name of the S3 bucket to use as the destination"
  default     = "firehose-s3-destination"
}

variable "firehose_delivery_stream_name" {
  description = "Name of the Kinesis Firehose delivery stream"
  default     = "my-firehose-stream"
}

variable "s3_prefix" {
  description = "Prefix for the S3 objects"
  default     = "firehose-data/"
}

resource "aws_iam_role" "firehose_role" {
  name = "firehose_delivery_role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = { Service = "firehose.amazonaws.com" }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "firehose_s3_access" {
  role       = aws_iam_role.firehose_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonS3FullAccess"
}

resource "aws_s3_bucket" "firehose_bucket" {
  bucket = var.s3_bucket_name
  acl    = "private"
}

resource "aws_kinesis_firehose_delivery_stream" "firehose_stream" {
  name        = var.firehose_delivery_stream_name
  destination = "s3"

  s3_configuration {
    role_arn       = aws_iam_role.firehose_role.arn
    bucket_arn     = aws_s3_bucket.firehose_bucket.arn
    prefix         = var.s3_prefix
    buffer_interval = 300
    buffer_size     = 5
    compression_format = "GZIP"
    error_output_prefix = "firehose-errors/"
    cloudwatch_logging_options {
      enabled = true
      log_group_name = "/aws/kinesisfirehose/my-firehose-stream"
      log_stream_name = "firehose-errors"
    }
  }
}

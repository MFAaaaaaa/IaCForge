[34:20m2026-07-07 21:10:33,903 - iac-eval - INFO - Model raw output: **Description of the Terraform Program:**

This Terraform configuration sets up an AWS infrastructure that allows users to upload and retrieve cat pictures. The system includes:

- An **AWS S3 bucket** to store uploaded cat pictures.
- An **AWS DynamoDB table** to keep track of uploaded cat pictures (e.g., storing metadata like the filename and upload timestamp).
- An **AWS Lambda function** that handles the logic for uploading and retrieving cat pictures.
- An **AWS API Gateway REST API** with a resource and method to expose endpoints for uploading and retrieving cat pictures.
- **AWS Lambda permissions** to allow API Gateway to invoke the Lambda function.
- A **provider configuration** for AWS in the `us-east-1` region.

All resources are fully declared, and default values are provided for any variables used.

---

**Terraform HCL Code:**

```hcl
provider "aws" {
  region = "us-east-1"
}

resource "aws_s3_bucket" "cat_pictures_bucket" {
  bucket = "cat-pictures-bucket-${random_string.bucket_suffix.result}"
  acl    = "private"

  tags = {
    Name        = "CatPicturesBucket"
    Environment = "dev"
  }
}

resource "random_string" "bucket_suffix" {
  length  = 8
  special = false
}

resource "aws_dynamodb_table" "cat_pictures_table" {
  name           = "cat-pictures-table-${random_string.table_suffix.result}"
  billing_mode   = "PAY_PER_REQUEST"
  hash_key       = "id"
  read_capacity  = 5
  write_capacity = 5

  attribute {
    name = "id"
    type = "S"
  }

  tags = {
    Name        = "CatPicturesTable"
    Environment = "dev"
  }
}

resource "random_string" "table_suffix" {
  length  = 8
  special = false
}

resource "aws_iam_role" "lambda_role" {
  name = "cat-picture-lambda-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = { Service = "lambda.amazonaws.com" }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "lambda_basic_execution" {
  role       = aws_iam_role.lambda_role.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

resource "aws_iam_role_policy" "lambda_s3_dynamodb_access" {
  name = "lambda-s3-dynamodb-access"
  role = aws_iam_role.lambda_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Action = [
          "s3:PutObject",
          "s3:GetObject",
          "s3:ListBucket"
        ]
        Resource = [
          aws_s3_bucket.cat_pictures_bucket.arn,
          "${aws_s3_bucket.cat_pictures_bucket.arn}/*"
        ]
      },
      {
        Effect = "Allow"
        Action = [
          "dynamodb:PutItem",
          "dynamodb:GetItem",
          "dynamodb:Scan"
        ]
        Resource = aws_dynamodb_table.cat_pictures_table.arn
      }
    ]
  })
}

resource "aws_lambda_function" "cat_picture_lambda" {
  function_name    = "cat-picture-lambda"
  role             = aws_iam_role.lambda_role.arn
  handler          = "index.handler"
  runtime          = "nodejs18.x"
  filename         = "lambda_function.zip"
  source_code_hash = filebase64sha256("lambda_function.zip")

  environment {
    variables = {
      BUCKET_NAME = aws_s3_bucket.cat_pictures_bucket.bucket
      TABLE_NAME  = aws_dynamodb_table.cat_pictures_table.name
    }
  }

  tags = {
    Name        = "CatPictureLambda"
    Environment = "dev"
  }
}

resource "aws_lambda_permission" "api_gateway_invoke_lambda" {
  statement_id  = "AllowAPIGateway"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.cat_picture_lambda.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = aws_api_gateway_rest_api.cat_picture_api.execution_arn
}

resource "aws_api_gateway_rest_api" "cat_picture_api" {
  name        = "CatPictureAPI"
  description = "API for uploading and retrieving cat pictures"
  minimum_compression_size = 1024
}

resource "aws_api_gateway_resource" "upload_resource" {
  rest_api_id = aws_api_gateway_rest_api.cat_picture_api.id
  parent_id   = aws_api_gateway_rest_api.cat_picture_api.root_resource_id
  path_part   = "upload"
}

resource "aws_api_gateway_method" "upload_method" {
  rest_api_id   = aws_api_gateway_rest_api.cat_picture_api.id
  resource_id   = aws_api_gateway_resource.upload_resource.id
  http_method   = "POST"
  authorization = "NONE"
}

resource "aws_api_gateway_integration" "upload_integration" {
  rest_api_id = aws_api_gateway_rest_api.cat_picture_api.id
  resource_id = aws_api_gateway_resource.upload_resource.id
  http_method = aws_api_gateway_method.upload_method.http_method
  type        = "AWS_PROXY"
  integration_http_method = "POST"
  uri         = aws_lambda_function.cat_picture_lambda.invoke_arn
}

resource "aws_api_gateway_method_response" "upload_method_response" {
  rest_api_id = aws_api_gateway_rest_api.cat_picture_api.id
  resource_id = aws_api_gateway_resource.upload_resource.id
  http_method = aws_api_gateway_method.upload_method.http_method
  status_code = "200"
}

resource "aws_api_gateway_integration_response" "upload_integration_response" {
  rest_api_id = aws_api_gateway_rest_api.cat_picture_api.id
  resource_id = aws_api_gateway_resource.upload_resource.id
  http_method = aws_api_gateway_method.upload_method.http_method
  status_code = "200"
  response_parameters = {
    "method.response.header.Content-Type" = "'application/json'"
  }
  response_templates = {
    "application/json" = "{}"
  }
}

resource "aws_api_gateway_method" "get_random_cat" {
  rest_api_id   = aws_api_gateway_rest_api.cat_picture_api.id
  resource_id   = aws_api_gateway_rest_api.cat_picture_api.root_resource_id
  http_method   = "GET"
  authorization = "NONE"
}

resource "aws_api_gateway_integration" "get_random_cat_integration" {
  rest_api_id = aws_api_gateway_rest_api.cat_picture_api.id
  resource_id = aws_api_gateway_rest_api.cat_picture_api.root_resource_id
  http_method = aws_api_gateway_method.get_random_cat.http_method
  type        = "AWS_PROXY"
  integration_http_method = "GET"
  uri         = aws_lambda_function.cat_picture_lambda.invoke_arn
}

resource "aws_api_gateway_method_response" "get_random_cat_method_response" {
  rest_api_id = aws_api_gateway_rest_api.cat_picture_api.id
  resource_id = aws_api_gateway_rest_api.cat_picture_api.root_resource_id
  http_method = aws_api_gateway_method.get_random_cat.http_method
  status_code = "200"
}

resource "aws_api_gateway_integration_response" "get_random_cat_integration_response" {
  rest_api_id = aws_api_gateway_rest_api.cat_picture_api.id
  resource_id = aws_api_gateway_rest_api.cat_picture_api.root_resource_id
  http_method = aws_api_gateway_method.get_random_cat.http_method
  status_code = "200"
  response_parameters = {
    "method.response.header.Content-Type" = "'application/json'"
  }
  response_templates = {
    "application/json" = "{}"
  }
}
```


[34:20m2026-07-07 21:04:27,589 - iac-eval - INFO - Model raw output: **Description of the Terraform Program:**

This Terraform configuration sets up the infrastructure for an autograder for a CS class. It creates an AWS S3 bucket to store student code and grading results, and an AWS CodeBuild project to run the autograding process. The CodeBuild project is configured to pull student code from a GitHub repository, execute the grading logic, and store the results in the S3 bucket. An IAM role is created for CodeBuild to grant it the necessary permissions to access the S3 bucket and GitHub (via a GitHub OAuth token stored in AWS Secrets Manager). The configuration includes a provider block for AWS, default values for variables, and ensures all resources are fully specified and deployable.

---

**Terraform HCL Program:**

```hcl
provider "aws" {
  region = "us-east-1"
}

variable "github_repo" {
  description = "The GitHub repository containing student code."
  default     = "cs-class-autograder-student-submissions"
}

variable "github_owner" {
  description = "The GitHub owner (user or organization) of the repository."
  default     = "cs-class"
}

variable "github_oauth_token" {
  description = "GitHub OAuth token for CodeBuild to access the repository."
  default     = "your-github-oauth-token"
}

variable "s3_bucket_name" {
  description = "Name of the S3 bucket to store grading results."
  default     = "cs-class-autograder-results"
}

resource "aws_s3_bucket" "autograder_results" {
  bucket = var.s3_bucket_name
  acl    = "private"

  tags = {
    Name        = "Autograder Results"
    Environment = "Development"
  }
}

resource "aws_s3_bucket_policy" "autograder_results_policy" {
  bucket = aws_s3_bucket.autograder_results.bucket

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Principal = {
          AWS = "arn:aws:iam::${aws_iam_role.codebuild_role.arn}:role/service-role/codebuild-role"
        }
        Action = [
          "s3:PutObject",
          "s3:GetObject"
        ]
        Resource = "arn:aws:s3:::${aws_s3_bucket.autograder_results.bucket}/*"
      }
    ]
  })
}

resource "aws_secretsmanager_secret" "github_oauth_token" {
  name        = "github-oauth-token"
  description = "GitHub OAuth token for CodeBuild to access the repository."
  secret_string = var.github_oauth_token
}

resource "aws_iam_role" "codebuild_role" {
  name = "codebuild-autograder-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Principal = {
          Service = "codebuild.amazonaws.com"
        }
        Action = "sts:AssumeRole"
      }
    ]
  })
}

resource "aws_iam_role_policy_attachment" "codebuild_s3_access" {
  role       = aws_iam_role.codebuild_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonS3FullAccess"
}

resource "aws_iam_role_policy_attachment" "codebuild_secretsmanager_access" {
  role       = aws_iam_role.codebuild_role.name
  policy_arn = "arn:aws:iam::aws:policy/SecretsManagerReadOnlyAccess"
}

resource "aws_codebuild_project" "autograder" {
  name          = "cs-class-autograder"
  description   = "Autograder for CS class submissions"
  source {
    type            = "GITHUB"
    location        = "https://github.com/${var.github_owner}/${var.github_repo}.git"
    branch          = "main"
    auth            = {
      type = "OAUTH"
      resource = aws_secretsmanager_secret.github_oauth_token.arn
    }
  }

  environment {
    type                = "LINUX_CONTAINER"
    image               = "aws/codebuild/amazonlinux2-x86_64-standard:3.0"
    compute_type        = "BUILD_GENERAL1_SMALL"
    environment_variables = {
      GITHUB_OAUTH_TOKEN = {
        value = aws_secretsmanager_secret.github_oauth_token.arn
        type  = "SECRETS_MANAGER"
      }
    }
  }

  service_role = aws_iam_role.codebuild_role.arn

  artifacts {
    type = "S3"
    location = aws_s3_bucket.autograder_results.bucket
  }

  buildspec = <<EOF
version: 0.2

phases:
  install:
    runtime-versions:
      python: 3.9
    commands:
      - echo "Installing dependencies..."
      - pip install -r requirements.txt
  build:
    commands:
      - echo "Running autograder..."
      - python autograde.py
artifacts:
  files:
    - results/*.json
  discard-paths: yes
EOF
}
```

---

This configuration is ready to be deployed with Terraform version `~> 1.9.8` and the AWS provider version `~> 5.75`. Replace the GitHub OAuth token and repository details with your actual values before deployment. (eval.py:730)[0m

  description = "Name of the voice connector group"
  default     = "vc-group"
}

resource "aws_chime_voice_connector" "connector_1" {
  name                  = var.voice_connector_name_1
  encryption_required   = true
  disable_user_input    = false
  enable_termination    = true
  enable_termination_metrics = true
}

resource "aws_chime_voice_connector" "connector_2" {
  name                  = var.voice_connector_name_2
  encryption_required   = true
  disable_user_input    = false
  enable_termination    = true
  enable_termination_metrics = true
}


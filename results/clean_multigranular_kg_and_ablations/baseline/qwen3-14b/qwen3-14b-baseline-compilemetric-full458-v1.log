[34:20m2026-07-07 21:03:53,661 - iac-eval - INFO - Model raw output: **Description of the Terraform Program:**

This Terraform configuration sets up an AWS CodeBuild project that will act as an autograder for a CS class. The project will pull code from a GitHub repository, execute the build process (which can include running tests or grading scripts), and store the results in an S3 bucket. The configuration includes:

- An AWS S3 bucket to store the build logs and results.
- An IAM role for CodeBuild with permissions to access the S3 bucket and GitHub.
- A CodeBuild project that is configured to use the GitHub repository and the IAM role.
- A GitHub OAuth token (as a Terraform variable) to allow CodeBuild to access the private GitHub repository.

The configuration is designed to be deployed in the `us-east-1` region and uses default values for variables where possible.

---

```hcl
provider "aws" {
  region = "us-east-1"
}

variable "github_token" {
  description = "GitHub personal access token for CodeBuild to access the repository"
  type        = string
  default     = "your_github_token_here"
}

variable "github_repo" {
  description = "GitHub repository in the format 'owner/repo'"
  type        = string
  default     = "cs-class/autograder"
}

variable "github_branch" {
  description = "Branch of the GitHub repository to build"
  type        = string
  default     = "main"
}

variable "s3_bucket_name" {
  description = "Name of the S3 bucket to store build logs and results"
  type        = string
  default     = "autograder-build-logs"
}

resource "aws_s3_bucket" "build_logs" {
  bucket = var.s3_bucket_name
  acl    = "private"

  versioning {
    enabled = true
  }

  server_side_encryption_configuration {
    rule {
      apply_server_side_encryption_by_default {
        sse_algorithm = "AES256"
      }
    }
  }
}

resource "aws_iam_role" "codebuild_role" {
  name = "codebuild-autograder-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "codebuild.amazonaws.com"
      }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "codebuild_s3_access" {
  role       = aws_iam_role.codebuild_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonS3FullAccess"
}

resource "aws_iam_role_policy_attachment" "codebuild_github_access" {
  role       = aws_iam_role.codebuild_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMReadOnlyAccess"
}

resource "aws_codebuild_project" "autograder" {
  name          = "autograder-project"
  description   = "CodeBuild project for autograding student submissions"
  source {
    type            = "GITHUB"
    location        = "https://github.com/${var.github_repo}.git"
    branch          = var.github_branch
    auth {
      type = "OAUTH"
      resource = "github.com"
    }
  }

  artifacts {
    type = "CODEPIPELINE"
  }

  environment {
    type                = "LINUX_CONTAINER"
    image               = "aws/codebuild/amazonlinux2-x86_64-standard:3.0"
    compute_type        = "BUILD_GENERAL1_SMALL"
    environment_variables = {
      GITHUB_TOKEN = {
        value = var.github_token
        type  = "PLAINTEXT"
      }
    }
  }

  service_role = aws_iam_role.codebuild_role.arn

  logs_config {
    cloudwatch_logs {
      status = "ENABLED"
    }
  }

  # Optional: Add buildspec.yaml content inline if needed
  # buildspec = file("buildspec.yaml")
}
```

---

**Note:** You will need to replace `your_github_token_here` with a valid GitHub personal access token that has access to the specified repository. You can also optionally provide a `buildspec.yaml` file that defines the build and test steps for the autograder. (eval.py:730)[0m

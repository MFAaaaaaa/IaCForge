provider "aws" {
  region = "us-east-1"
}

resource "aws_lex_bot" "pizza_ordering_bot" {
  name                     = "PizzaOrderingBot"
  description              = "A bot for ordering pizzas"
  locale                   = "en-US"
  child_directed           = false
  clarification_prompt {
    message = "I didn't understand. Can you please rephrase?"
    max_attempts = 2
  }
  abort_statement {
    message = "Okay, let's try again later."
  }
  conclusion_statement {
    message = "Your pizza order has been confirmed. Thank you for ordering with us!"
  }

  intents {
    intent_name = "OrderPizza"
    slots {
      name = "PizzaType"
      value_elicitation_prompt {
        message = "What type of pizza would you like?"
        max_attempts = 2
      }
    }
    slots {
      name = "Size"
      value_elicitation_prompt {
        message = "What size would you like?"
        max_attempts = 2
      }
    }
    slots {
      name = "Toppings"
      value_elicitation_prompt {
        message = "What toppings would you like?"
        max_attempts = 2
      }
    }
  }
}
```


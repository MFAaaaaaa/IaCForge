[34:20m2026-07-07 20:56:19,610 - iac-eval - INFO - Model raw output: **Description of the Terraform Program:**

This Terraform configuration will create an AWS Chime Voice Connector and configure a Voice Connector Logging resource to enable logging of **only media metrics**. The configuration includes the necessary provider setup, IAM permissions, and resource definitions to ensure the Chime Voice Connector is created and logging is enabled with the specified settings.

---

**Terraform HCL Code:**

```hcl
provider "aws" {
  region = "us-east-1"
}

# IAM Role for Chime Voice Connector
resource "aws_iam_role" "chime_voice_connector_role" {
  name = "chime-voice-connector-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "chime.amazonaws.com"
      }
      Action = "sts:AssumeRole"
    }]
  })
}

# IAM Role Policy for Chime Voice Connector
resource "aws_iam_role_policy_attachment" "chime_voice_connector_policy" {
  role       = aws_iam_role.chime_voice_connector_role.name
  policy_arn = "arn:aws:iam::aws:policy/AWSChimeVoiceConnectorFullAccess"
}

# AWS Chime Voice Connector
resource "aws_chime_voice_connector" "example" {
  name                  = "example-voice-connector"
  outbound_calling_name = "example-vc"
  require_encryption    = true
  role_arn              = aws_iam_role.chime_voice_connector_role.arn
}

# AWS Chime Voice Connector Logging
resource "aws_chime_voice_connector_logging" "example" {
  voice_connector_id = aws_chime_voice_connector.example.id
  media_metrics      = true
  call_details       = false
}
```


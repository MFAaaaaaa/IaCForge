  handler          = "index.handler"
  runtime          = "nodejs18.x"
  filename         = "lambda_function.zip"
  source_code_hash = filebase64sha256("lambda_function.zip")

  timeout = 30
  memory_size = 128

  environment {
    variables = {
      MESSAGE = "This is a daily execution at 7 UTC."
    }
  }
}

resource "aws_eventbridge_rule" "daily_execution" {
  name        = "daily_execution_rule"
  description = "Triggers the Lambda function daily at 7:00 UTC."
  schedule_expression = "cron(0 7 * * ? *)"
  state       = "ENABLED"
}

resource "aws_eventbridge_rule_target" "lambda_target" {
  rule      = aws_eventbridge_rule.daily_execution.name
  target_id = "daily_code_executor"
  arn       = aws_lambda_function.daily_code_executor.arn
}
```


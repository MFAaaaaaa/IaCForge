This Terraform configuration creates an AWS SageMaker endpoint, which is used to deploy and run machine learning models in production. The configuration includes the necessary IAM role for SageMaker to access resources, a SageMaker endpoint configuration, and the endpoint itself. The configuration is set up in the `us-east-1` region, which is a common region for SageMaker. Default values are provided for variables to ensure the configuration is deployable without additional input.

---

**Terraform HCL Program:**

```hcl
provider "aws" {
  region = "us-east-1"
}

variable "sagemaker_endpoint_name" {
  description = "Name of the SageMaker endpoint"
  default     = "my-sagemaker-endpoint"
}

variable "sagemaker_role_arn" {
  description = "ARN of the IAM role for SageMaker"
  default     = "arn:aws:iam::123456789012:role/service-role/AmazonSageMaker-ExecutionRole-20230101"
}

resource "aws_iam_role" "sagemaker_execution_role" {
  name = "sagemaker-execution-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "sagemaker.amazonaws.com"
      }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "sagemaker_execution_role_policy" {
  role       = aws_iam_role.sagemaker_execution_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSageMakerFullAccess"
}

resource "aws_sagemaker_endpoint_configuration" "example" {
  name = "example-endpoint-config"

  production_variants {
    variant_name          = "variant1"
    model_name            = "example-model"
    initial_instance_count = 1
    instance_type         = "ml.m5.large"
  }
}

resource "aws_sagemaker_endpoint" "example" {
  name                   = var.sagemaker_endpoint_name
  endpoint_config_name = aws_sagemaker_endpoint_configuration.example.name
  deployment_config {
    blue_green_update_policy {
      minimum_successful_wait_time_in_seconds = 300
      wait_interval_seconds                   = 60
      termination_wait_timeout_in_seconds     = 600
    }
  }
}
```

---


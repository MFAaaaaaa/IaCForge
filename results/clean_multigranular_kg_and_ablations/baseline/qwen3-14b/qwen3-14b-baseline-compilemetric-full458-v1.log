resource "aws_elasticache_subnet_group" "example" {
  name        = "my-elasticache-subnet-group"
  description = "Subnet group for ElastiCache"
  subnet_ids  = [aws_subnet.private1.id, aws_subnet.private2.id]
}

resource "aws_security_group" "elasticache" {
  name        = "elasticache-sg"
  description = "Security group for ElastiCache"
  vpc_id      = aws_vpc.main.id

  ingress {
    from_port   = 6379
    to_port     = 6379
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_vpc" "main" {
  cidr_block = "10.0.0.0/16"
}

resource "aws_subnet" "private1" {
  vpc_id            = aws_vpc.main.id
  cidr_block        = "10.0.1.0/24"
  availability_zone = "us-west-2a"
  map_public_ip_on_launch = false
}

resource "aws_subnet" "private2" {
  vpc_id            = aws_vpc.main.id
  cidr_block        = "10.0.2.0/24"
  availability_zone = "us-west-2b"
  map_public_ip_on_launch = false
}

resource "aws_iam_role" "elasticache_user" {
  name = "elasticache-user-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = { Service = "elasticache.amazonaws.com" }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "elasticache_user" {
  role       = aws_iam_role.elasticache_user.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWS_ElastiCache_DefaultRole"
}

resource "aws_elasticache_user" "example" {
  user_id         = "my-elasticache-user"
  user_name       = "my-elasticache-user"
  engine          = "redis"
  passwords       = ["MySecurePassword123!"]
  access_string   = "on ~app~ * +@all"
  no_password_required = false
  replication_group_id = aws_elasticache_replication_group.example.replication_group_id
}
```

---

**Notes:**

- This configuration assumes that you have a VPC and subnets already created or that you want to create them as part of the setup.
- The `aws_elasticache_user` resource creates a user with a password and grants full access (`+@all`) to the ElastiCache cluster.
- The IAM role `aws_iam_role.elasticache_user` is used to allow ElastiCache to manage the user and access the cluster.
- The password is set to `"MySecurePassword123!"` and can be changed as needed.

Let me know if you'd like to add authentication via AWS Secrets Manager or integrate with an application using the user credentials. (eval.py:730)[0m

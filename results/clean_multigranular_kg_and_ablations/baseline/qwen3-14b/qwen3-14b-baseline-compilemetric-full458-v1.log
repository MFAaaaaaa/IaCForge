[34:20m2026-07-07 21:00:37,916 - iac-eval - INFO - Model raw output: **Description of the Terraform Program:**

This Terraform configuration will create two AWS S3 buckets: one for storing user data and another for storing the CSV inventory reports. It will configure an S3 inventory on the first bucket to generate a weekly CSV report of all current object versions and store the report in the second bucket. The configuration includes proper IAM roles and policies to ensure the S3 inventory can be created and managed securely.

---

```hcl
provider "aws" {
  region = "us-west-2"
}

# Create the main S3 bucket for storing objects
resource "aws_s3_bucket" "main_bucket" {
  bucket = "main-bucket-terraform-inventory"
  acl    = "private"

  versioning {
    enabled = true
  }

  tags = {
    Name        = "main-bucket"
    Environment = "dev"
  }
}

# Create the S3 bucket for storing inventory reports
resource "aws_s3_bucket" "inventory_bucket" {
  bucket = "inventory-bucket-terraform"
  acl    = "private"

  tags = {
    Name        = "inventory-bucket"
    Environment = "dev"
  }
}

# Create an IAM role for S3 inventory
resource "aws_iam_role" "s3_inventory_role" {
  name = "s3-inventory-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "s3.amazonaws.com"
      }
      Action = "sts:AssumeRole"
    }]
  })
}

# Attach the S3 inventory policy to the role
resource "aws_iam_role_policy_attachment" "s3_inventory_policy" {
  role       = aws_iam_role.s3_inventory_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonS3InventoryRolePolicy"
}

# Configure the S3 inventory on the main bucket
resource "aws_s3_bucket_inventory" "main_inventory" {
  bucket      = aws_s3_bucket.main_bucket.bucket
  name        = "main-bucket-inventory"
  enabled     = true
  schedule    = "Weekly"
  inventory_schema_version = "2.0"

  included_object_versions = "All"

  destination {
    bucket {
      bucket_arn = aws_s3_bucket.inventory_bucket.arn
      format     = "CSV"
    }
  }

  optional_fields = [
    "Size",
    "LastModifiedDate",
    "StorageClass",
    "ReplicationStatus",
    "IsMultipartUploaded",
    "ETag",
    "ObjectSize",
    "StorageClass",
    "LastModifiedDate",
    "IsLatestVersion",
    "VersionId",
    "EncryptionStatus",
    "ReplicationStatus",
    "ObjectLockMode",
    "ObjectLockLegalHoldStatus",
    "ObjectLockRetentionMode",
    "ObjectLockRetentionPeriod"
  ]
}
``` (eval.py:730)[0m

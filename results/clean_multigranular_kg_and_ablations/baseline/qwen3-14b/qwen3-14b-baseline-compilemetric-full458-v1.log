This Terraform configuration will create a VPC with public subnets, a security group for database access, and a PostgreSQL database instance. The PostgreSQL instance will be configured with version 17.1, 5GB storage, and will be named `dolphinscheduler`. It will be deployed within the VPC and secured by a dedicated security group. The setup will skip the final snapshot and will be deployed in the `us-east-1` region.

---

**Terraform HCL Code:**

```hcl
provider "aws" {
  region = "us-east-1"
}

# Create a VPC
resource "aws_vpc" "main" {
  cidr_block = "10.0.0.0/16"
  tags = {
    Name = "dolphinscheduler-vpc"
  }
}

# Create public subnets
resource "aws_subnet" "public" {
  count = 2
  vpc_id = aws_vpc.main.id
  cidr_block = cidrsubnet(aws_vpc.main.cidr_block, 8, count.index)
  map_public_ip_on_launch = true
  availability_zone = data.aws_availability_zones.available.names[count.index]
  tags = {
    Name = "public-subnet-${count.index + 1}"
  }
}

data "aws_availability_zones" "available" {
  state = "available"
}

# Create an internet gateway
resource "aws_internet_gateway" "main" {
  vpc_id = aws_vpc.main.id
  tags = {
    Name = "dolphinscheduler-igw"
  }
}

# Create a route table for public subnets
resource "aws_route_table" "public" {
  vpc_id = aws_vpc.main.id
  tags = {
    Name = "public-route-table"
  }
}

# Associate route table with public subnets
resource "aws_route_table_association" "public" {
  count = 2
  subnet_id = aws_subnet.public[count.index].id
  route_table_id = aws_route_table.public.id
}

# Create a route to the internet gateway
resource "aws_route" "internet_gateway" {
  route_table_id = aws_route_table.public.id
  destination_cidr_block = "0.0.0.0/0"
  gateway_id = aws_internet_gateway.main.id
}

# Create a security group for the PostgreSQL database
resource "aws_security_group" "postgres" {
  name        = "dolphinscheduler-postgres-sg"
  description = "Allow access to PostgreSQL database"
  vpc_id      = aws_vpc.main.id

  ingress {
    from_port   = 5432
    to_port     = 5432
    protocol    = "tcp"
    cidr_blocks = ["10.0.0.0/16"]  # Allow access within the VPC
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "dolphinscheduler-postgres-sg"
  }
}

# Create a PostgreSQL RDS instance
resource "aws_db_instance" "dolphinscheduler" {
  identifier = "dolphinscheduler"
  engine = "postgres"
  engine_version = "17.1"
  instance_class = "db.t3.medium"
  allocated_storage = 5
  username = "postgres"
  password = "SecurePassword123!"
  db_name = "dolphinscheduler_db"
  vpc_security_group_ids = [aws_security_group.postgres.id]
  subnet_ids = aws_subnet.public[*].id
  skip_final_snapshot = true
  tags = {
    Name = "dolphinscheduler-db"
  }
}
```

---

**Notes:**

- The PostgreSQL instance is configured with a username `postgres` and a password `SecurePassword123!`. You should replace this with a more secure password in production.
- The `skip_final_snapshot` is set to `true` as requested.
- The PostgreSQL version is set to `17.1`, and the allocated storage is `5GB`.
- The security group allows access to port `5432` from within the VPC only.
- The VPC is created with a CIDR block of `10.0.0.0/16`, and two public subnets are created in two availability zones.


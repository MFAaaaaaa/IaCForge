This Terraform configuration creates an AWS CodeBuild project with the following components:
- An IAM role that allows CodeBuild to access AWS resources and interact with GitHub.
- A GitHub source configuration for the CodeBuild project.
- An S3 artifact bucket to store build outputs.
- A cache configuration using an S3 bucket to speed up repeated builds.

The configuration includes a provider block for AWS, a default region, and all necessary resources and IAM policies to make the CodeBuild project functional.

---

```hcl
provider "aws" {
  region = "us-east-1"
}

resource "aws_s3_bucket" "codebuild_artifacts" {
  bucket = "codebuild-artifacts-example"
  acl    = "private"
}

resource "aws_s3_bucket" "codebuild_cache" {
  bucket = "codebuild-cache-example"
  acl    = "private"
}

resource "aws_iam_role" "codebuild_role" {
  name = "codebuild-role-example"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "codebuild.amazonaws.com"
      }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "codebuild_basic" {
  role       = aws_iam_role.codebuild_role.name
  policy_arn = "arn:aws:iam::aws:policy/AWSCodeBuildBasicPolicy"
}

resource "aws_iam_role_policy_attachment" "codebuild_s3_access" {
  role       = aws_iam_role.codebuild_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonS3FullAccess"
}

resource "aws_iam_role_policy_attachment" "codebuild_github_access" {
  role       = aws_iam_role.codebuild_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonEC2ContainerRegistryPowerUser"
}

resource "aws_codebuild_project" "example" {
  name          = "codebuild-project-example"
  description   = "Example CodeBuild project with GitHub source and S3 artifacts"
  service_role  = aws_iam_role.codebuild_role.arn

  source {
    type            = "GITHUB"
    location        = "https://github.com/example/repo.git"
    branch          = "main"
    auth            = "OAUTH_TOKEN"
    oauth_token     = "your_github_oauth_token_here"
  }

  artifacts {
    type = "S3"
    path = "build-output"
    location = aws_s3_bucket.codebuild_artifacts.bucket
  }

  cache {
    type = "S3"
    location = aws_s3_bucket.codebuild_cache.bucket
  }

  environment {
    type                = "LINUX_CONTAINER"
    image               = "aws/codebuild/amazonlinux2-x86_64-standard:3.0"
    compute_type        = "BUILD_GENERAL1_SMALL"
  }

  timeout_in_minutes = 10
}
```

---

**Note:** Replace `"your_github_oauth_token_here"` with a valid GitHub OAuth token for the CodeBuild project to access the GitHub repository. This token should be stored securely, such as in AWS Secrets Manager or using Terraform's `sensitive` attribute. (eval.py:730)[0m
